"use client";

import { useRouter } from "next/navigation";

type Option = {
  slug: string;
  name: string;
};

type InternationalProducerFiltersProps = {
  countries: Option[];
  regions: Option[];
  selectedCountry: string;
  selectedRegion: string;
  anchor?: string;
  mobile?: boolean;
};

export default function InternationalProducerFilters({
  countries,
  regions,
  selectedCountry,
  selectedRegion,
  anchor = "repertoire-desktop",
  mobile = false,
}: InternationalProducerFiltersProps) {
  const router = useRouter();

  function go(country: string, region: string) {
    const query = new URLSearchParams();

    query.set("origine", "ailleurs");

    if (country) {
      query.set("pays", country);
    }

    if (region) {
      query.set("region", region);
    }

    router.push(`/producteurs?${query.toString()}#${anchor}`);
  }

  return (
    <div
      className={
        mobile
          ? "flex min-w-0 items-center gap-4"
          : "flex min-w-0 items-center gap-6"
      }
    >
      <label className="flex min-w-0 items-baseline gap-2">
        <span className="shrink-0 text-[0.46rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
          Pays
        </span>

        <span className="relative min-w-0">
          <select
            value={selectedCountry}
            onChange={(event) => go(event.target.value, "")}
            aria-label="Filtrer par pays"
            className={
              mobile
                ? "max-w-[92px] appearance-none border-0 bg-transparent py-0 pr-4 text-[0.62rem] uppercase tracking-[0.08em] text-[var(--lpv-ink)] outline-none"
                : "max-w-[150px] appearance-none border-0 bg-transparent py-0 pr-4 text-[0.62rem] uppercase tracking-[0.08em] text-[var(--lpv-ink)] outline-none"
            }
          >
            <option value="">Tous</option>

            {countries.map((country) => (
              <option key={country.slug} value={country.slug}>
                {country.name}
              </option>
            ))}
          </select>

          <span
            aria-hidden="true"
            className="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 text-[0.45rem] text-[var(--lpv-muted)]"
          >
            ↓
          </span>
        </span>
      </label>

      <span
        aria-hidden="true"
        className="text-[0.55rem] text-[var(--lpv-line)]"
      >
        ·
      </span>

      <label className="flex min-w-0 items-baseline gap-2">
        <span className="shrink-0 text-[0.46rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
          Région
        </span>

        <span className="relative min-w-0">
          <select
            value={selectedRegion}
            onChange={(event) => go(selectedCountry, event.target.value)}
            aria-label="Filtrer par région"
            className={
              mobile
                ? "max-w-[100px] appearance-none border-0 bg-transparent py-0 pr-4 text-[0.62rem] uppercase tracking-[0.08em] text-[var(--lpv-ink)] outline-none"
                : "max-w-[165px] appearance-none border-0 bg-transparent py-0 pr-4 text-[0.62rem] uppercase tracking-[0.08em] text-[var(--lpv-ink)] outline-none"
            }
          >
            <option value="">Toutes</option>

            {regions.map((region) => (
              <option key={region.slug} value={region.slug}>
                {region.name}
              </option>
            ))}
          </select>

          <span
            aria-hidden="true"
            className="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 text-[0.45rem] text-[var(--lpv-muted)]"
          >
            ↓
          </span>
        </span>
      </label>
    </div>
  );
}
