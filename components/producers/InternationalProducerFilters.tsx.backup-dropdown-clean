"use client";

import { useRouter } from "next/navigation";

type Option = {
  slug: string;
  name: string;
};

type InternationalProducerFiltersProps = {
  countries: Option[];
  regions: Option[];
  selectedCountry: string;
  selectedRegion: string;
  anchor?: string;
  mobile?: boolean;
};

export default function InternationalProducerFilters({
  countries,
  regions,
  selectedCountry,
  selectedRegion,
  anchor = "repertoire-desktop",
  mobile = false,
}: InternationalProducerFiltersProps) {
  const router = useRouter();

  function go(country: string, region: string) {
    const query = new URLSearchParams();

    query.set("origine", "ailleurs");

    if (country) {
      query.set("pays", country);
    }

    if (region) {
      query.set("region", region);
    }

    router.push(`/producteurs?${query.toString()}#${anchor}`);
  }

  return (
    <div
      className={
        mobile
          ? "flex flex-wrap items-center gap-x-5 gap-y-3"
          : "flex flex-wrap items-center gap-x-7 gap-y-3"
      }
    >
      <span className="text-[0.52rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
        Pays
      </span>

      <label className="relative">
        <select
          value={selectedCountry}
          onChange={(event) => go(event.target.value, "")}
          aria-label="Filtrer par pays"
          className="cursor-pointer appearance-none border-0 border-b border-[var(--lpv-cocoa)] bg-transparent pb-1 pr-4 text-[0.57rem] font-semibold uppercase tracking-[0.14em] text-[var(--lpv-ink)] outline-none"
        >
          <option value="">Tous</option>

          {countries.map((country) => (
            <option key={country.slug} value={country.slug}>
              {country.name}
            </option>
          ))}
        </select>

        <span
          aria-hidden="true"
          className="pointer-events-none absolute right-0 top-[1px] text-[0.45rem] text-[var(--lpv-muted)]"
        >
          ↓
        </span>
      </label>

      <span className="ml-1 text-[0.52rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
        Région
      </span>

      <label className="relative">
        <select
          value={selectedRegion}
          onChange={(event) => go(selectedCountry, event.target.value)}
          aria-label="Filtrer par région"
          className="cursor-pointer appearance-none border-0 border-b border-[var(--lpv-cocoa)] bg-transparent pb-1 pr-4 text-[0.57rem] font-semibold uppercase tracking-[0.14em] text-[var(--lpv-ink)] outline-none"
        >
          <option value="">Toutes</option>

          {regions.map((region) => (
            <option key={region.slug} value={region.slug}>
              {region.name}
            </option>
          ))}
        </select>

        <span
          aria-hidden="true"
          className="pointer-events-none absolute right-0 top-[1px] text-[0.45rem] text-[var(--lpv-muted)]"
        >
          ↓
        </span>
      </label>
    </div>
  );
}
