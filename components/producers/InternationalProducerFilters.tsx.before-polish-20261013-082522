"use client";

import { useRouter } from "next/navigation";

type Option = {
  slug: string;
  name: string;
};

type InternationalProducerFiltersProps = {
  countries: Option[];
  regions: Option[];
  selectedCountry: string;
  selectedRegion: string;
  anchor?: string;
  mobile?: boolean;
};

export default function InternationalProducerFilters({
  countries,
  regions,
  selectedCountry,
  selectedRegion,
  anchor = "repertoire-desktop",
  mobile = false,
}: InternationalProducerFiltersProps) {
  const router = useRouter();

  function go(country: string, region: string) {
    const query = new URLSearchParams();

    query.set("origine", "ailleurs");

    if (country) {
      query.set("pays", country);
    }

    if (region) {
      query.set("region", region);
    }

    router.push(`/producteurs?${query.toString()}#${anchor}`);
  }

  return (
    <div
      className={
        mobile
          ? "grid grid-cols-2 gap-3"
          : "flex items-center gap-7"
      }
    >
      <label
        className={
          mobile
            ? "block border border-[var(--lpv-line)] px-3 py-3"
            : "flex items-center gap-3"
        }
      >
        <span className="text-[0.52rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
          Pays
        </span>

        <span className={mobile ? "relative mt-1 block" : "relative"}>
          <select
            value={selectedCountry}
            onChange={(event) => go(event.target.value, "")}
            className={
              mobile
                ? "w-full appearance-none border-0 bg-transparent py-1 pr-5 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--lpv-cocoa)] outline-none"
                : "appearance-none border-0 bg-transparent py-1 pr-5 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-[var(--lpv-cocoa)] outline-none"
            }
          >
            <option value="">Tous</option>

            {countries.map((country) => (
              <option key={country.slug} value={country.slug}>
                {country.name}
              </option>
            ))}
          </select>

          <span
            aria-hidden="true"
            className="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 text-[0.55rem] text-[var(--lpv-cocoa)]"
          >
            ↓
          </span>
        </span>
      </label>

      {!mobile ? (
        <span className="h-4 w-px bg-[var(--lpv-line)]" />
      ) : null}

      <label
        className={
          mobile
            ? "block border border-[var(--lpv-line)] px-3 py-3"
            : "flex items-center gap-3"
        }
      >
        <span className="text-[0.52rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
          Région
        </span>

        <span className={mobile ? "relative mt-1 block" : "relative"}>
          <select
            value={selectedRegion}
            onChange={(event) => go(selectedCountry, event.target.value)}
            className={
              mobile
                ? "w-full appearance-none border-0 bg-transparent py-1 pr-5 text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--lpv-cocoa)] outline-none"
                : "appearance-none border-0 bg-transparent py-1 pr-5 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-[var(--lpv-cocoa)] outline-none"
            }
          >
            <option value="">Toutes</option>

            {regions.map((region) => (
              <option key={region.slug} value={region.slug}>
                {region.name}
              </option>
            ))}
          </select>

          <span
            aria-hidden="true"
            className="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 text-[0.55rem] text-[var(--lpv-cocoa)]"
          >
            ↓
          </span>
        </span>
      </label>
    </div>
  );
}
