datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cellarBottles CellarBottle[]
}

model CellarBottle {
  id             String    @id @default(cuid())
  wineId         String
  userId         String?
  quantity       Int       @default(1)
  purchasePrice  Float?
  purchaseDate   DateTime?
  location       String?
  drinkingWindow String?
  personalNote   String?
  rating         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  wine           Wine      @relation(fields: [wineId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([wineId])
  @@index([userId])
}

model Wine {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  producer    String?
  country     String?
  region      String?
  grape       String?
  color       String?
  style       String?
  price       Float?
  vintage     String?
  image       String?
  aromasJson  String?
  tagsJson    String?
  description String?
  isQuebec    Boolean @default(false)
  featured    Boolean @default(false)
  body        String?
  acidity     String?
  tannin      String?
  minerality  String?
  pairingJson String?
  serving     String?
  temperature String?
  cellar      String?

  vineyardId String?
  vineyard   Vineyard? @relation(fields: [vineyardId], references: [id], onDelete: SetNull)

  originLabel String?
  latitude    Float?
  longitude   Float?
  placeId     String?

  saqCode                String? @unique
  saqUrl                 String?
  appellationOrigine     String?
  designationReglementee String?
  alcohol                String?
  tauxSucre              String?
  natureType             String?
  bioType                String?
  formatMl               Int?
  sourceFile             String?
  dataSource             String? @default("manual")

  sugar  String?
  palate String?
  oak    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cellarBottles CellarBottle[]

  @@index([country])
  @@index([region])
  @@index([color])
  @@index([isQuebec])
  @@index([featured])
  @@index([dataSource])
  @@index([saqCode])
}

model Vineyard {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  country          String?
  region           String?
  province         String?
  city             String?
  address          String?
  postalCode       String?
  latitude         Float?
  longitude        Float?
  placeId          String?
  website          String?
  phone            String?
  email            String?
  image            String?
  isQuebec         Boolean  @default(false)
  isActiveVisit    Boolean  @default(true)
  tastingOffered   Boolean  @default(false)
  lodgingOffered   Boolean  @default(false)
  restaurantOnSite Boolean  @default(false)
  routesJson       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wines Wine[]
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  content        String    @db.Text
  coverImage     String?
  category       String?
  tagsJson       String?
  author         String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  featured       Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ShopProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  shortDesc   String?
  priceCents  Int
  currency    String   @default("cad")
  image       String?
  category    String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  inventory   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems ShopOrderItem[]
}

model ShopOrder {
  id                    String   @id @default(cuid())
  email                 String
  status                String   @default("pending")
  currency              String   @default("cad")
  subtotalCents         Int
  totalCents            Int
  stripePaymentIntentId String?  @unique
  shippingName          String?
  shippingAddressLine1  String?
  shippingAddressLine2  String?
  shippingCity          String?
  shippingState         String?
  shippingPostalCode    String?
  shippingCountry       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items ShopOrderItem[]
}

model ShopOrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int

  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@index([userId, feature, createdAt])
}

model WineJournal {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id")
  wineId    String    @map("wine_id")
  favorite  Boolean   @default(false)
  tasted    Boolean   @default(false)
  buyAgain  Boolean   @default(false) @map("buy_again")
  gift      Boolean   @default(false)
  avoid     Boolean   @default(false)
  rating    Int?
  note      String?
  tastedAt  DateTime? @map("tasted_at") @db.Timestamptz(6)
  location  String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, wineId])
  @@index([userId])
  @@index([wineId])
  @@map("wine_journal")
}

model AnalyticsEvent {
  id String @id @default(cuid())

  // Événement
  eventName  String
  occurredAt DateTime @default(now())

  // Visiteur
  clerkUserId String?
  sessionId   String?

  // Contenu principal concerné — ID canonique Sanity
  contentId   String?
  contentType String?
  contentSlug String?

  // Producteur concerné, lorsqu'il est connu
  producerId   String?
  producerSlug String?

  // Contexte du produit
  beverageType String?
  country      String?
  region       String?
  isQuebec     Boolean?
  price        Float?

  // Origine de l'interaction
  sourceType String?
  sourceId   String?
  sourceSlug String?

  // Recommandations / parcours de découverte
  recommendationId     String?
  recommendationReason String?

  // Destination d'un clic
  destinationType String?
  destinationId   String?
  destinationUrl  String?

  // Recherche / filtres
  searchQuery String?
  filterName  String?
  filterValue String?

  // Données additionnelles non sensibles
  metadata Json?

  @@index([eventName, occurredAt])
  @@index([contentId, occurredAt])
  @@index([producerId, occurredAt])
  @@index([clerkUserId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([isQuebec, occurredAt])
  @@index([beverageType, occurredAt])
  @@index([sourceType, occurredAt])
  @@index([recommendationId, occurredAt])
}
