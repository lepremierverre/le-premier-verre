datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cellarBottles CellarBottle[]
}

model CellarBottle {
  id             String    @id @default(cuid())
  contentId      String
  contentType    String    @default("wine")
  userId         String?
  quantity       Int       @default(1)
  purchasePrice  Float?
  purchaseDate   DateTime?
  location       String?
  drinkingWindow String?
  personalNote   String?
  rating         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([contentType])
  @@index([userId])
}




model ShopProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  shortDesc   String?
  priceCents  Int
  currency    String   @default("cad")
  image       String?
  category    String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  inventory   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@index([userId, feature, createdAt])
}


model AnalyticsEvent {
  id            String   @id @default(cuid())
  clientEventId String?  @unique
  eventName     String
  eventVersion  Int      @default(1)
  occurredAt    DateTime @default(now())
  receivedAt    DateTime @default(now())
  environment   String   @default("development")

  // Qualité et auditabilité
  isReportable  Boolean  @default(true)
  qualityReason String?
  duplicateOfId String?

  // Visiteur — aucun renseignement personnel requis pour un visiteur anonyme
  clerkUserId    String?
  sessionId      String?
  isAuthenticated Boolean @default(false)

  // Page et acquisition
  pagePath    String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Contenu principal — ID canonique Sanity
  contentId   String?
  contentType String?
  contentSlug String?

  // Producteur
  producerId   String?
  producerSlug String?

  // Contexte du produit
  beverageType  String?
  isAlcoholFree Boolean?
  country       String?
  province     String?
  region       String?
  isQuebec     Boolean?
  price        Float?
  priceBand    String?

  // Origine de l'interaction
  sourceType String?
  sourceId   String?
  sourceSlug String?

  // Recommandations et parcours de découverte
  recommendationId     String?
  recommendationReason String?

  // Destination d'un clic
  destinationType String?
  destinationId   String?
  destinationUrl  String?

  // Recherche et filtres
  searchQuery String?
  resultCount Int?
  filterName  String?
  filterValue String?

  // Données additionnelles non sensibles
  metadata Json?

  @@index([eventName, occurredAt])
  @@index([environment, occurredAt])
  @@index([isReportable, eventName, occurredAt])
  @@index([contentId, occurredAt])
  @@index([producerId, occurredAt])
  @@index([clerkUserId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([isQuebec, occurredAt])
  @@index([beverageType, occurredAt])
  @@index([sourceType, occurredAt])
  @@index([recommendationId, occurredAt])
  @@index([utmCampaign, occurredAt])
}
