import Link from "next/link";
import type { SanityImageSource } from "@sanity/image-url";

import FavoriteButton from "@/components/favorites/FavoriteButton";
import AnalyticsEvent from "@/components/analytics/AnalyticsEvent";
import CatalogFilterAnalytics from "@/components/analytics/CatalogFilterAnalytics";
import CatalogTypeFilterLink from "@/components/analytics/CatalogTypeFilterLink";
import { client } from "@/sanity/lib/client";
import { urlFor } from "@/sanity/lib/image";
import { winesQuery } from "@/sanity/lib/queries";
import BottleStage from "@/components/wine/BottleStage";
import { filterWineCatalog, normalizeCatalogQuery } from "@/lib/catalog/wine-catalog";

export const revalidate = 60;

type WineCard = {
  _id: string;
  name: string;
  slug: string;
  vintage?: number;
  beverageType?: "wine" | "cider";
  alcoholFree?: boolean;
  color?: string;
  style?: string;
  appleVarieties?: string[];
  saqPrice?: number;
  bottleImage?: SanityImageSource;
  producer?: {
    name?: string;
    slug?: string;
  };
  country?: {
    name?: string;
    slug?: string;
  };
  region?: {
    name?: string;
    slug?: string;
  };
  appellation?: {
    name?: string;
    slug?: string;
  };
};

type SearchParams = Promise<{
  q?: string;
  type?: string;
  color?: string;
  country?: string;
  region?: string;
  price?: string;
  page?: string;
}>;

function formatLabel(value?: string) {
  if (!value) return null;

  const labels: Record<string, string> = {
    red: "Rouge",
    white: "Blanc",
    rose: "Rosé",
    orange: "Orange",
    sparkling: "Effervescent",
    fortified: "Fortifié",
    dry: "Sec",
    "off-dry": "Demi-sec",
    sweet: "Doux",
    natural: "Nature",
    classic: "Classique",
  };

  return labels[value] || value.replace(/[-_]/g, " ");
}

export default async function VinsPage({
  searchParams,
}: {
  searchParams: SearchParams;
}) {
  const params = await searchParams;
  const wines = await client.fetch<WineCard[]>(winesQuery);

  const query = normalizeCatalogQuery(params.q, "fr");
  const selectedType = params.type ?? "";
  const selectedColor = params.color ?? "";
  const selectedCountry = params.country ?? "";
  const selectedRegion = params.region ?? "";
  const selectedPrice = params.price ?? "";

  const requestedPage = Math.max(
    1,
    Number.parseInt(params.page ?? "1", 10) || 1
  );

  const colors = [
    ...new Set(
      wines
        .map((wine) => wine.color)
        .filter((value): value is string => Boolean(value))
    ),
  ].sort();

  const countries = [
    ...new Set(
      wines
        .map((wine) => wine.country?.name)
        .filter((value): value is string => Boolean(value))
    ),
  ].sort();

  const regions = [
    ...new Set(
      wines
        .map((wine) => wine.region?.name)
        .filter((value): value is string => Boolean(value))
    ),
  ].sort();

  const filteredWines = filterWineCatalog(
    wines,
    {
      q: params.q,
      type: selectedType,
      color: selectedColor,
      country: selectedCountry,
      region: selectedRegion,
      price: selectedPrice,
    },
    "fr"
  );

  const winesPerPage = 12;
  const totalPages = Math.max(
    1,
    Math.ceil(filteredWines.length / winesPerPage)
  );

  const currentPage = Math.min(requestedPage, totalPages);
  const startIndex = (currentPage - 1) * winesPerPage;
  const paginatedWines = filteredWines.slice(
    startIndex,
    startIndex + winesPerPage
  );

  function pageHref(page: number) {
    const nextParams = new URLSearchParams();

    if (params.q) nextParams.set("q", params.q);
    if (selectedType) nextParams.set("type", selectedType);
    if (selectedColor) nextParams.set("color", selectedColor);
    if (selectedCountry) nextParams.set("country", selectedCountry);
    if (selectedRegion) nextParams.set("region", selectedRegion);
    if (selectedPrice) nextParams.set("price", selectedPrice);

    if (page > 1) {
      nextParams.set("page", String(page));
    }

    const queryString = nextParams.toString();

    return queryString ? `/vins?${queryString}` : "/vins";
  }

  const hasFilters = Boolean(
    query ||
      selectedType ||
      selectedColor ||
      selectedCountry ||
      selectedRegion ||
      selectedPrice
  );

  const quebecWines = wines.filter((wine) => {
    const country = wine.country?.name?.toLowerCase() ?? "";
    const region = wine.region?.name?.toLowerCase() ?? "";
    const appellation = wine.appellation?.name?.toLowerCase() ?? "";

    return (
      country.includes("canada") ||
      region.includes("québec") ||
      region.includes("quebec") ||
      appellation.includes("québec") ||
      appellation.includes("quebec")
    );
  });

  const featuredQuebecWines = quebecWines.slice(0, 6);

  return (
    <main className="min-h-screen bg-[var(--lpv-paper)] text-[var(--lpv-ink)]">
      {query.length >= 2 ? (
        <AnalyticsEvent
          eventName="search_performed"
          data={{
            searchQuery: params.q?.trim() ?? "",
            sourceType: "wine_catalog_fr",
            metadata: {
              type: selectedType || undefined,
              color: selectedColor || undefined,
              country: selectedCountry || undefined,
              region: selectedRegion || undefined,
              price: selectedPrice || undefined,
            },
          }}
        />
      ) : null}
      {/* INTRO */}
      <section className="border-b border-[var(--lpv-line)]">
        <div className="lpv-container grid gap-7 py-10 md:grid-cols-[0.68fr_0.32fr] md:items-end md:gap-10 md:py-24">
          <div>
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              Répertoire
            </p>

            <h1 className="lpv-display mt-5 max-w-5xl text-[clamp(3.5rem,14vw,4.5rem)] leading-[0.86] md:mt-7 md:text-[clamp(4.8rem,10vw,10rem)] md:leading-[0.82]">
              Les bouteilles
              <br />
              de la bibliothèque.
            </h1>
          </div>

          <div className="border-t border-[var(--lpv-line)] pt-5 md:border-t-0 md:pb-2 md:pt-6">
            <p className="max-w-md text-base leading-7 text-[var(--lpv-muted)] md:leading-8">
              Une sélection de bouteilles à découvrir, à garder sous la main
              et à ouvrir au bon moment.
            </p>

            <p className="lpv-kicker mt-7 text-[var(--lpv-cocoa)]">
              {wines.length} bouteilles dans la collection
            </p>
          </div>
        </div>
      </section>

      {/* BARRE DE CATALOGUE */}
      <section className="relative z-40 border-b border-[var(--lpv-line)] bg-[var(--lpv-paper)]">
        <div className="lpv-container">

          <div className="flex flex-wrap items-center justify-between gap-5 py-5 md:min-h-[80px] md:flex-nowrap md:py-0">

            <div className="flex flex-wrap items-center gap-x-8 gap-y-3">
              {[
                { label: "Tout", value: "" },
                { label: "Vins", value: "wine" },
                { label: "Cidres", value: "cider" },
                { label: "Sans alcool", value: "alcohol-free" },
              ].map((item) => {
                const href = item.value
                  ? `/vins?type=${item.value}`
                  : "/vins";

                const active = selectedType === item.value;

                return (
                  <CatalogTypeFilterLink
                    key={item.label}
                    href={href}
                    value={item.value}
                    locale="fr"
                    className={`text-[0.68rem] font-medium uppercase tracking-[0.16em] transition-opacity hover:opacity-50 ${
                      active
                        ? "text-[var(--lpv-ink)] underline underline-offset-8"
                        : "text-[var(--lpv-muted)]"
                    }`}
                  >
                    {item.label}
                  </CatalogTypeFilterLink>
                );
              })}
            </div>

            <div className="flex items-center gap-7">

              <form
                action="/vins"
                method="get"
                className="hidden items-center border-b border-[var(--lpv-line)] md:flex"
              >
                {selectedType ? (
                  <input
                    type="hidden"
                    name="type"
                    value={selectedType}
                  />
                ) : null}

                <input
                  type="search"
                  name="q"
                  defaultValue={params.q ?? ""}
                  placeholder="Rechercher"
                  aria-label="Rechercher une bouteille"
                  className="w-[155px] border-0 bg-transparent py-2 text-sm outline-none placeholder:text-[var(--lpv-muted)]"
                />

                <button
                  type="submit"
                  aria-label="Lancer la recherche"
                  className="pb-1 text-sm"
                >
                  →
                </button>
              </form>

              <details className="group relative">
                <summary className="flex cursor-pointer list-none items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.16em] [&::-webkit-details-marker]:hidden">
                  Filtrer
                  <span className="text-base font-light transition-transform group-open:rotate-45">
                    +
                  </span>
                </summary>

                <div className="absolute right-0 top-[calc(100%+28px)] z-50 w-[700px] border border-[var(--lpv-line)] bg-[var(--lpv-paper)] p-7 shadow-[0_24px_60px_rgba(30,25,21,0.12)]">

                  <CatalogFilterAnalytics
                    locale="fr"
                    className="block"
                  >
                    {selectedType ? (
                      <input
                        type="hidden"
                        name="type"
                        value={selectedType}
                      />
                    ) : null}

                    <div className="grid grid-cols-2 gap-x-8 gap-y-7">

                      <label className="col-span-2 border-b border-[var(--lpv-line)] pb-3">
                        <span className="mb-2 block text-[0.56rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                          Rechercher
                        </span>

                        <input
                          type="search"
                          name="q"
                          defaultValue={params.q ?? ""}
                          placeholder="Bouteille, producteur, région…"
                          className="w-full border-0 bg-transparent text-base outline-none placeholder:text-[var(--lpv-muted)]/55"
                        />
                      </label>

                      <label className="border-b border-[var(--lpv-line)] pb-3">
                        <span className="mb-2 block text-[0.56rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                          Couleur
                        </span>

                        <select
                          name="color"
                          defaultValue={selectedColor}
                          className="w-full appearance-none border-0 bg-transparent text-sm outline-none"
                        >
                          <option value="">Toutes</option>
                          {colors.map((color) => (
                            <option key={color} value={color}>
                              {formatLabel(color)}
                            </option>
                          ))}
                        </select>
                      </label>

                      <label className="border-b border-[var(--lpv-line)] pb-3">
                        <span className="mb-2 block text-[0.56rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                          Pays
                        </span>

                        <select
                          name="country"
                          defaultValue={selectedCountry}
                          className="w-full appearance-none border-0 bg-transparent text-sm outline-none"
                        >
                          <option value="">Tous</option>
                          {countries.map((country) => (
                            <option key={country} value={country}>
                              {country}
                            </option>
                          ))}
                        </select>
                      </label>

                      <label className="border-b border-[var(--lpv-line)] pb-3">
                        <span className="mb-2 block text-[0.56rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                          Région
                        </span>

                        <select
                          name="region"
                          defaultValue={selectedRegion}
                          className="w-full appearance-none border-0 bg-transparent text-sm outline-none"
                        >
                          <option value="">Toutes</option>
                          {regions.map((region) => (
                            <option key={region} value={region}>
                              {region}
                            </option>
                          ))}
                        </select>
                      </label>

                      <label className="border-b border-[var(--lpv-line)] pb-3">
                        <span className="mb-2 block text-[0.56rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                          Prix
                        </span>

                        <select
                          name="price"
                          defaultValue={selectedPrice}
                          className="w-full appearance-none border-0 bg-transparent text-sm outline-none"
                        >
                          <option value="">Tous les prix</option>
                          <option value="under-20">Moins de 20 $</option>
                          <option value="20-30">20 à 30 $</option>
                          <option value="30-40">30 à 40 $</option>
                          <option value="40-60">40 à 60 $</option>
                          <option value="60-plus">60 $ et +</option>
                        </select>
                      </label>

                    </div>

                    <div className="mt-7 flex items-center gap-5">
                      <button
                        type="submit"
                        className="lpv-button lpv-button-dark"
                      >
                        Appliquer
                      </button>

                      {hasFilters ? (
                        <Link
                          href="/vins"
                          className="lpv-text-link"
                        >
                          Réinitialiser
                        </Link>
                      ) : null}
                    </div>

                  </CatalogFilterAnalytics>

                </div>
              </details>

            </div>
          </div>
        </div>
      </section>

      {/* D'ICI — DESKTOP */}
      {featuredQuebecWines.length > 0 ? (
        <section className="hidden overflow-hidden bg-[var(--lpv-cocoa)] text-[var(--lpv-paper-light)] md:block">
          <div className="lpv-container py-12 lg:py-14">

            <div className="flex items-end justify-between gap-10">
              <div>
                <p className="lpv-kicker text-white/42">
                  Le Québec dans le verre
                </p>

                <h2 className="lpv-display mt-3 text-[clamp(4.2rem,5.8vw,6.5rem)] leading-[0.84] tracking-[-0.05em]">
                  D’ici.
                </h2>
              </div>

              <Link
                href="/vins?country=Canada"
                className="group mb-2 inline-flex items-center gap-3 border-b border-white/35 pb-1 text-[0.64rem] font-semibold uppercase tracking-[0.16em] text-white"
              >
                Tous les vins du Québec
                <span className="transition-transform duration-300 group-hover:translate-x-1">
                  →
                </span>
              </Link>
            </div>

            <div className="mt-8 overflow-x-auto pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              <div className="flex w-max gap-3 snap-x snap-mandatory">

                {featuredQuebecWines.map((wine, index) => (
                  <article
                    key={wine._id}
                    className="group relative flex h-[520px] w-[365px] shrink-0 snap-start flex-col border border-white/22"
                  >
                    <Link
                      href={`/vins/${wine.slug}`}
                      className="flex h-full flex-col px-6 pb-6 pt-6"
                    >
                      <span className="font-[var(--font-display)] text-[1.8rem] leading-none text-white/38">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <div className="relative mt-4 flex h-[286px] items-center justify-center bg-white/[0.055]">
                        <BottleStage
                          image={wine.bottleImage}
                          alt={wine.name}
                          color={wine.color}
                          variant="card"
                          className="!h-[270px] !w-full [&>div]:!h-[255px] [&_img]:!max-h-[245px] [&_img]:!max-w-[62%] [&_img]:transition-transform [&_img]:duration-500 [&_img]:ease-out group-hover:[&_img]:-translate-y-2 group-hover:[&_img]:rotate-[0.8deg] group-hover:[&_img]:scale-[1.025]"
                        />
                      </div>

                      <div className="mt-auto flex min-h-[150px] flex-col border-t border-white/22 pt-4">
                        <p className="lpv-kicker text-white/48">
                          {[
                            wine.beverageType === "cider"
                              ? "Cidre"
                              : formatLabel(wine.color) || "Vin",
                            wine.alcoholFree ? "Sans alcool" : null,
                            wine.vintage,
                          ]
                            .filter(Boolean)
                            .join(" · ")}
                        </p>

                        <h3 className="lpv-display mt-3 text-[1.8rem] leading-[0.94] tracking-[-0.035em] transition-opacity group-hover:opacity-65">
                          {wine.name}
                        </h3>

                        {wine.producer?.name ? (
                          <p className="mt-auto pt-4 text-sm text-white/52">
                            {wine.producer.name}
                          </p>
                        ) : null}
                      </div>
                    </Link>

                    <div className="absolute right-4 top-4 z-20 opacity-0 transition-opacity duration-200 group-hover:opacity-100 focus-within:opacity-100">
                      <FavoriteButton
                        wineId={wine._id}
                        size="sm"
                      />
                    </div>
                  </article>
                ))}

              </div>
            </div>

            {featuredQuebecWines.length > 3 ? (
              <div className="mt-2 flex justify-end">
                <span className="lpv-kicker text-white/38">
                  Glisser →
                </span>
              </div>
            ) : null}

          </div>
        </section>
      ) : null}

      {/* CATALOGUE */}



      <section className="lpv-container py-10 md:py-24">
        <div className="flex flex-col gap-3 border-b border-[var(--lpv-line)] pb-5 sm:flex-row sm:items-end sm:justify-between md:gap-5 md:pb-6">
          <div>
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              Catalogue
            </p>

            <h2 className="lpv-display mt-3 text-[2.8rem] leading-none md:mt-5 md:text-7xl">
              Et d’ailleurs.
            </h2>
          </div>

          <p className="text-xs uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
            {filteredWines.length} résultat
            {filteredWines.length > 1 ? "s" : ""}
          </p>
        </div>

        {filteredWines.length > 0 ? (
          <>
            {/* MOBILE — carte actuelle conservée */}
            <div className="grid grid-cols-2 gap-x-4 md:hidden">
              {paginatedWines.map((wine, index) => {
                const location = [
                  wine.region?.name,
                  wine.country?.name,
                ]
                  .filter(Boolean)
                  .join(" · ");

                return (
                  <article
                    key={wine._id}
                    className="group flex min-w-0 flex-col border-b border-[var(--lpv-line)] pb-3 pt-2"
                  >
                    <div className="relative">
                      <Link
                        href={`/vins/${wine.slug}`}
                        className="block w-full"
                      >
                        <BottleStage
                          image={wine.bottleImage}
                          alt={wine.name}
                          color={wine.color}
                          variant="card"
                          className="!h-[220px] [&>div]:!h-[190px] sm:!h-[250px] sm:[&>div]:!h-[220px]"
                        />
                      </Link>

                      <div className="absolute right-0 top-0 z-20">
                        <FavoriteButton
                          wineId={wine._id}
                          size="sm"
                        />
                      </div>
                    </div>

                    <div className="flex flex-1 flex-col pt-4">
                      <div className="flex min-h-[16px] items-start justify-between gap-2">
                        <p className="lpv-kicker min-w-0 text-[0.55rem] leading-4 tracking-[0.16em] text-[var(--lpv-cocoa)]">
                          {[
                            wine.beverageType === "cider"
                              ? "Cidre"
                              : formatLabel(wine.color) || "Vin",
                            wine.alcoholFree ? "Sans alcool" : null,
                            wine.vintage,
                          ]
                            .filter(Boolean)
                            .join(" · ")}
                        </p>

                        <span className="shrink-0 text-[0.52rem] tracking-[0.12em] text-[var(--lpv-muted)]">
                          {String(startIndex + index + 1).padStart(2, "0")}
                        </span>
                      </div>

                      <Link
                        href={`/vins/${wine.slug}`}
                        className="mt-3 block"
                      >
                        <h3 className="lpv-display min-h-[2.73rem] text-[1.45rem] leading-[0.94]">
                          {wine.name}
                        </h3>
                      </Link>

                      {wine.producer?.name ? (
                        <p className="mt-3 text-xs leading-5 text-[var(--lpv-muted)]">
                          {wine.producer.name}
                        </p>
                      ) : null}

                      {location ? (
                        <p className="mt-2 text-[0.68rem] leading-5 text-[var(--lpv-muted)]">
                          {location}
                        </p>
                      ) : null}
                    </div>
                  </article>
                );
              })}
            </div>

            {/* DESKTOP — cartes éditoriales simplifiées */}
            <div className="hidden grid-cols-3 md:grid">
              {paginatedWines.map((wine, index) => (
                <article
                  key={wine._id}
                  className={`group relative flex min-w-0 flex-col border-b border-[var(--lpv-line)] px-8 pb-8 pt-6 ${
                    index % 3 !== 0
                      ? "border-l border-[var(--lpv-line)]"
                      : ""
                  }`}
                >
                  <div className="relative">
                    <Link
                      href={`/vins/${wine.slug}`}
                      className="block"
                    >
                      <span className="absolute left-0 top-0 z-10 font-[var(--font-display)] text-[1.7rem] leading-none text-[var(--lpv-muted)]/45">
                        {String(startIndex + index + 1).padStart(2, "0")}
                      </span>

                      <BottleStage
                        image={wine.bottleImage}
                        alt={wine.name}
                        color={wine.color}
                        variant="card"
                        className="!h-[330px] [&>div]:!h-[305px] [&_img]:!max-h-[295px] [&_img]:!max-w-[60%] [&_img]:transition-transform [&_img]:duration-500 [&_img]:ease-out group-hover:[&_img]:-translate-y-2 group-hover:[&_img]:rotate-[0.7deg] group-hover:[&_img]:scale-[1.02]"
                      />
                    </Link>

                    <div className="absolute right-0 top-0 z-20">
                      <FavoriteButton
                        wineId={wine._id}
                        size="sm"
                      />
                    </div>
                  </div>

                  <Link
                    href={`/vins/${wine.slug}`}
                    className="mt-auto block border-t border-[var(--lpv-line)] pt-5"
                  >
                    <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                      {[
                        wine.beverageType === "cider"
                          ? "Cidre"
                          : formatLabel(wine.color) || "Vin",
                        wine.alcoholFree ? "Sans alcool" : null,
                        wine.vintage,
                      ]
                        .filter(Boolean)
                        .join(" · ")}
                    </p>

                    <h3 className="lpv-display mt-3 min-h-[4rem] max-w-[360px] text-[2.15rem] leading-[0.94] tracking-[-0.035em] transition-opacity group-hover:opacity-60">
                      {wine.name}
                    </h3>

                    {wine.producer?.name ? (
                      <p className="mt-5 text-sm leading-5 text-[var(--lpv-muted)]">
                        {wine.producer.name}
                      </p>
                    ) : null}
                  </Link>
                </article>
              ))}
            </div>

            {totalPages > 1 ? (
              <nav
                aria-label="Pagination des bouteilles"
                className="mt-12 flex flex-wrap items-center justify-between gap-6 pt-8"
              >
                <div>
                  {currentPage > 1 ? (
                    <Link
                      href={pageHref(currentPage - 1)}
                      className="lpv-text-link"
                    >
                      ← Précédent
                    </Link>
                  ) : (
                    <span className="text-sm text-[var(--lpv-muted)]/40">
                      ← Précédent
                    </span>
                  )}
                </div>

                <div className="flex items-center gap-2">
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map(
                    (page) => (
                      <Link
                        key={page}
                        href={pageHref(page)}
                        aria-current={page === currentPage ? "page" : undefined}
                        className={`flex h-10 min-w-10 items-center justify-center border px-3 text-sm transition-opacity hover:opacity-60 ${
                          page === currentPage
                            ? "border-[var(--lpv-ink)] text-[var(--lpv-ink)]"
                            : "border-[var(--lpv-line)] text-[var(--lpv-muted)]"
                        }`}
                      >
                        {page}
                      </Link>
                    )
                  )}
                </div>

                <div>
                  {currentPage < totalPages ? (
                    <Link
                      href={pageHref(currentPage + 1)}
                      className="lpv-text-link"
                    >
                      Suivant →
                    </Link>
                  ) : (
                    <span className="text-sm text-[var(--lpv-muted)]/40">
                      Suivant →
                    </span>
                  )}
                </div>
              </nav>
            ) : null}
          </>
        ) : (
          <div className="py-20 text-center">
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              Aucun résultat
            </p>

            <h2 className="lpv-display mt-6 text-5xl">
              Rien pour le moment.
            </h2>

            <p className="mx-auto mt-5 max-w-lg text-base leading-8 text-[var(--lpv-muted)]">
              Essaie une autre recherche ou retire certains filtres.
            </p>

            <Link
              href="/vins"
              className="lpv-button mt-8"
            >
              Voir toutes les bouteilles
            </Link>
          </div>
        )}
      </section>
    </main>
  );
}
