@import "tailwindcss";

:root {
  --lpv-paper: #f4efe7;
  --lpv-paper-light: #fbf8f2;
  --lpv-white: #fffdf9;
  --lpv-ink: #211d1a;
  --lpv-cocoa: #604c3d;
  --lpv-cocoa-dark: #49382e;
  --lpv-burgundy: #702f40;
  --lpv-olive: #59604d;
  --lpv-muted: #776d65;
  --lpv-line: rgba(33, 29, 26, 0.16);
  --lpv-line-light: rgba(33, 29, 26, 0.09);

  --font-display: var(--font-editorial);
  --font-body: var(--font-sans);

  --ease-editorial: cubic-bezier(0.22, 1, 0.36, 1);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--lpv-paper);
  color: var(--lpv-ink);
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--lpv-paper);
  color: var(--lpv-ink);
  font-family: var(--font-body);
  text-rendering: optimizeLegibility;
}

::selection {
  background: var(--lpv-cocoa);
  color: var(--lpv-paper-light);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  display: block;
  max-width: 100%;
}

.lpv-container {
  width: min(1440px, calc(100% - 32px));
  margin-inline: auto;
}

.lpv-container-narrow {
  width: min(980px, calc(100% - 32px));
  margin-inline: auto;
}

.lpv-display {
  font-family: var(--font-display);
  font-weight: 400;
  letter-spacing: -0.045em;
}

.lpv-kicker {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  line-height: 1;
  text-transform: uppercase;
}

.lpv-rule {
  border-top: 1px solid var(--lpv-line);
}

.lpv-text-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding-bottom: 0.22rem;
  border-bottom: 1px solid currentColor;
  font-size: 0.78rem;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  transition:
    opacity 220ms ease,
    gap 320ms var(--ease-editorial);
}

.lpv-text-link:hover {
  gap: 0.75rem;
  opacity: 0.62;
}

.lpv-button {
  display: inline-flex;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.8rem 1.35rem;
  border: 1px solid var(--lpv-ink);
  border-radius: 999px;
  background: transparent;
  color: var(--lpv-ink);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.17em;
  text-transform: uppercase;
  transition:
    background 250ms ease,
    color 250ms ease,
    transform 300ms var(--ease-editorial);
}

.lpv-button:hover {
  transform: translateY(-2px);
  background: var(--lpv-ink);
  color: var(--lpv-paper-light);
}

.lpv-button-dark {
  background: var(--lpv-ink);
  color: var(--lpv-paper-light);
}

.lpv-button-dark:hover {
  background: var(--lpv-cocoa);
}

.lpv-editorial-card {
  border-top: 1px solid var(--lpv-line);
  background: transparent;
}

.lpv-editorial-card img {
  transition: transform 1100ms var(--ease-editorial);
}

.lpv-editorial-card:hover img {
  transform: scale(1.018);
}

.lpv-prose {
  font-size: 1.04rem;
  line-height: 1.9;
}

.lpv-prose p + p {
  margin-top: 1.4em;
}

.lpv-fade-in {
  animation: lpvFadeIn 700ms var(--ease-editorial) both;
}

@keyframes lpvFadeIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (min-width: 768px) {
  .lpv-container,
  .lpv-container-narrow {
    width: min(1440px, calc(100% - 80px));
  }
}


.lpv-luxury-image > img {
  filter: saturate(0.96) contrast(0.98);
}

.lpv-luxury-image:hover > img {
  filter: saturate(1) contrast(1);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Clerk — intégration Le Premier Verre */
.cl-rootBox,
.cl-cardBox {
  width: 100%;
}

.cl-cardBox,
.cl-card,
.cl-footer {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.cl-headerTitle {
  font-family: var(--font-display) !important;
  font-weight: 400 !important;
  letter-spacing: -0.045em !important;
}

.cl-formFieldInput,
.cl-formFieldInput:focus {
  box-shadow: none !important;
}

.cl-footerPages,
.cl-footerPagesLink {
  display: none !important;
}

/* =========================================================
   LE PREMIER VERRE — ÉDITION IMPRIMABLE DES GUIDES
   ========================================================= */

.guide-checklist-print {
  display: none;
}

@media print {
  @page {
    size: auto;
    margin: 16mm 17mm 18mm;
  }

  /* Base papier */
  html,
  body {
    background: #fff !important;
  }

  body {
    color: #181512 !important;
    font-size: 10.5pt !important;
    line-height: 1.55 !important;
  }

  /* Retirer l'interface du site */
  body > header,
  body > footer,
  .guide-screen-only,
  .guide-actions {
    display: none !important;
  }

  /* Le guide devient un document pleine largeur */
  main:has(.guide-print-content) {
    min-height: 0 !important;
    background: #fff !important;
    color: #181512 !important;
  }

  main:has(.guide-print-content) article {
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* ---------------------------------------------------------
     COUVERTURE / EN-TÊTE DU DOCUMENT
     --------------------------------------------------------- */

  .guide-print-hero {
    display: block !important;
    border-bottom: 1px solid #b9b2aa !important;
    padding: 0 0 11mm !important;
    margin: 0 0 12mm !important;
  }

  .guide-print-hero > div:first-child {
    position: static !important;
  }

  .guide-print-cover-image {
    display: none !important;
  }

  .guide-print-hero .lpv-kicker {
    margin: 0 0 5mm !important;
    color: #6f6257 !important;
    font-size: 8pt !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
  }

  .guide-print-hero h1 {
    max-width: 165mm !important;
    margin: 0 !important;
    font-size: 34pt !important;
    line-height: 0.98 !important;
    letter-spacing: -0.035em !important;
    color: #181512 !important;
  }

  .guide-print-hero h1 + p {
    max-width: 145mm !important;
    margin: 6mm 0 0 !important;
    color: #5e5750 !important;
    font-size: 11pt !important;
    line-height: 1.5 !important;
  }

  /* ---------------------------------------------------------
     CONTENU DU GUIDE
     --------------------------------------------------------- */

  .guide-print-content {
    display: block !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Masque "Le guide / À savoir." — utile à l'écran,
     inutile dans le document papier */
  .guide-print-content > div:first-child {
    display: none !important;
  }

  .guide-print-content > div:last-child {
    width: 100% !important;
    max-width: none !important;
  }

  .guide-print-content .lpv-prose {
    width: 100% !important;
    max-width: none !important;
    font-size: 10.5pt !important;
    line-height: 1.55 !important;
  }

  .guide-print-content .lpv-prose p {
    color: #181512 !important;
    orphans: 3;
    widows: 3;
  }

  .guide-print-content .lpv-prose p + p {
    margin-top: 0.85em !important;
  }

  /* Titres numérotés */
  .guide-print-content .lpv-prose div:has(> .lpv-kicker + h2) {
    break-after: avoid-page;
    page-break-after: avoid;
    margin-top: 9mm !important;
    margin-bottom: 4mm !important;
  }

  .guide-print-content .lpv-prose div:has(> .lpv-kicker + h2) .lpv-kicker {
    margin-bottom: 1.5mm !important;
    color: #74675c !important;
    font-size: 7.5pt !important;
    letter-spacing: 0.16em !important;
  }

  .guide-print-content .lpv-prose h2 {
    break-after: avoid-page;
    page-break-after: avoid;
    margin-top: 9mm !important;
    margin-bottom: 4mm !important;
    color: #181512 !important;
    font-size: 20pt !important;
    line-height: 1.05 !important;
  }

  .guide-print-content .lpv-prose h3 {
    break-after: avoid-page;
    page-break-after: avoid;
    margin-top: 6mm !important;
    margin-bottom: 3mm !important;
    color: #181512 !important;
    font-size: 13pt !important;
    line-height: 1.15 !important;
  }

  /* Tableaux / blocs pratiques */
  .guide-print-content table,
  .guide-print-content .not-prose {
    break-inside: avoid-page;
    page-break-inside: avoid;
  }

  .guide-print-content table {
    width: 100% !important;
    font-size: 9pt !important;
  }

  /* Checklist interactive : jamais dans le corps imprimé */
  .guide-checklist-screen {
    display: none !important;
  }

  /* ---------------------------------------------------------
     NE PAS IMPRIMER LE CONTENU WEB APRÈS LE GUIDE
     --------------------------------------------------------- */

  .guide-print-content ~ section:not(.guide-checklist-print),
  .guide-print-content ~ .guide-actions {
    display: none !important;
  }

  /* ---------------------------------------------------------
     ANNEXE CHECKLIST — DERNIÈRE PAGE
     --------------------------------------------------------- */

  .guide-checklist-print {
    display: block !important;
    break-before: page;
    page-break-before: always;
    position: relative;
    min-height: 235mm;
    padding: 2mm 0 12mm;
    color: #181512 !important;
    background: #fff !important;
  }

  .guide-checklist-print-heading {
    border-bottom: 1px solid #aaa39b;
    padding-bottom: 7mm;
    margin-bottom: 9mm;
  }

  .guide-checklist-print-kicker {
    margin: 0 0 4mm !important;
    color: #74675c !important;
    font-size: 7.5pt !important;
    font-weight: 600 !important;
    letter-spacing: 0.17em !important;
    text-transform: uppercase !important;
  }

  .guide-checklist-print-heading h2 {
    margin: 0 !important;
    max-width: 145mm;
    color: #181512 !important;
    font-family: var(--font-display);
    font-size: 27pt !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    letter-spacing: -0.035em !important;
  }

  .guide-checklist-print-heading > p:last-child {
    margin: 4mm 0 0 !important;
    max-width: 125mm;
    color: #5e5750 !important;
    font-size: 9.5pt !important;
    line-height: 1.45 !important;
  }

  .guide-checklist-print-groups {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 8mm !important;
  }

  .guide-checklist-print-group {
    break-inside: avoid !important;
    page-break-inside: avoid !important;
  }

  .guide-checklist-print-group h3 {
    margin: 0 0 5mm !important;
    padding-bottom: 2.5mm !important;
    border-bottom: 1px solid #c8c2bc !important;
    color: #6f6257 !important;
    font-size: 8pt !important;
    font-weight: 600 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
  }

  .guide-checklist-print-item {
    display: flex !important;
    align-items: flex-start !important;
    gap: 3mm !important;
    margin-bottom: 4.5mm !important;
    break-inside: avoid !important;
  }

  .guide-checklist-print-item > span {
    display: block !important;
    width: 4mm !important;
    height: 4mm !important;
    flex: 0 0 4mm !important;
    margin-top: 0.5mm !important;
    border: 1px solid #4f4944 !important;
    background: #fff !important;
  }

  .guide-checklist-print-item p {
    margin: 0 !important;
    color: #181512 !important;
    font-size: 9.5pt !important;
    line-height: 1.35 !important;
  }

  .guide-checklist-print-footer {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    border-top: 1px solid #c8c2bc;
    padding-top: 3mm;
    color: #74675c !important;
    font-size: 7pt !important;
    letter-spacing: 0.13em !important;
  }

  /* Impression propre */
  a {
    color: inherit !important;
    text-decoration: none !important;
  }

  * {
    box-shadow: none !important;
    text-shadow: none !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
}

/* =========================================================
   LPV — HOME MOTION
   Editorial / cinematic / visible
   ========================================================= */

.lpv-reveal {
  --lpv-reveal-delay: 0ms;
  opacity: 0;
  transform: translate3d(0, 28px, 0);
  transition:
    opacity 900ms cubic-bezier(.22,.61,.36,1) var(--lpv-reveal-delay),
    transform 1100ms cubic-bezier(.22,.61,.36,1) var(--lpv-reveal-delay);
}

.lpv-reveal.is-visible {
  opacity: 1;
  transform: translate3d(0,0,0);
}


/* ---------------------------------------------------------
   CE SOIR
   --------------------------------------------------------- */

.lpv-cinematic-image {
  opacity: 0;
  transform: translate3d(0,26px,0) scale(1.03);
  transition:
    transform 1200ms cubic-bezier(.22,.61,.36,1) 80ms,
    opacity 700ms ease 80ms;
}

.lpv-reveal.is-visible .lpv-cinematic-image {
  opacity: 1;
  transform: translate3d(0,0,0) scale(1);
}

.lpv-cinematic-copy {
  opacity: 0;
  transform: translate3d(0,24px,0);
  transition:
    opacity 850ms ease 300ms,
    transform 1150ms cubic-bezier(.22,.61,.36,1) 300ms;
}

.lpv-reveal.is-visible .lpv-cinematic-copy {
  opacity: 1;
  transform: translate3d(0,0,0);
}


/* ---------------------------------------------------------
   TROIS BOUTEILLES
   --------------------------------------------------------- */

.lpv-bottle-motion {
  opacity: 0;
  transform: translate3d(0,44px,0) scale(.985);
  transition:
    opacity 800ms ease,
    transform 1200ms cubic-bezier(.22,.61,.36,1);
}

.lpv-reveal.is-visible .lpv-bottle-motion {
  opacity: 1;
  transform: translate3d(0,0,0) scale(1);
}

.lpv-reveal.is-visible .lpv-bottle-motion:nth-child(1) {
  transition-delay: 100ms;
}

.lpv-reveal.is-visible .lpv-bottle-motion:nth-child(2) {
  transition-delay: 280ms;
}

.lpv-reveal.is-visible .lpv-bottle-motion:nth-child(3) {
  transition-delay: 460ms;
}


/* ---------------------------------------------------------
   À DÉCOUVRIR — TITRE
   --------------------------------------------------------- */

.lpv-discovery-heading {
  transform: translate3d(0,38px,0);
}

.lpv-discovery-heading.is-visible {
  transform: translate3d(0,0,0);
}


/* ---------------------------------------------------------
   À DÉCOUVRIR — LES 3 RENDEZ-VOUS
   --------------------------------------------------------- */

.lpv-discovery-row {
  overflow: hidden;
}

.lpv-discovery-row .lpv-luxury-image {
  opacity: 0;
  transform: translate3d(0,27px,0) scale(1.025);
  transition:
    opacity 750ms ease,
    transform 1200ms cubic-bezier(.22,.61,.36,1);
}

.lpv-discovery-row .lpv-discovery-copy {
  opacity: 0;
  transform: translate3d(0,25px,0);
  transition:
    opacity 850ms ease 220ms,
    transform 1150ms cubic-bezier(.22,.61,.36,1) 220ms;
}

.lpv-discovery-row.is-visible .lpv-luxury-image {
  opacity: 1;
  transform: translate3d(0,0,0) scale(1);
}

.lpv-discovery-row.is-visible .lpv-discovery-copy {
  opacity: 1;
  transform: translate3d(0,0,0);
}


/* ---------------------------------------------------------
   PHOTOS — HOVER
   --------------------------------------------------------- */

.lpv-luxury-image > img {
  transform: scale(1);
  transition:
    transform 1100ms cubic-bezier(.22,.61,.36,1),
    filter 700ms ease;
}

.lpv-luxury-image:hover > img {
  transform: scale(1.06);
}


/* ---------------------------------------------------------
   BOUTONS — HOVER
   --------------------------------------------------------- */

.lpv-luxury-button {
  position: relative;
  overflow: hidden;
  transition:
    transform 350ms cubic-bezier(.22,.61,.36,1),
    opacity 300ms ease;
}

.lpv-luxury-button:hover {
  transform: translateY(-3px);
  opacity: .88;
}

.lpv-luxury-button span {
  display: inline-block;
  transition: transform 350ms cubic-bezier(.22,.61,.36,1);
}

.lpv-luxury-button:hover span {
  transform: translateX(8px);
}


/* ---------------------------------------------------------
   ACCESSIBILITÉ
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .lpv-reveal,
  .lpv-discovery-heading,
  .lpv-cinematic-image,
  .lpv-cinematic-copy,
  .lpv-bottle-motion,
  .lpv-discovery-row .lpv-luxury-image,
  .lpv-discovery-row .lpv-discovery-copy {
    opacity: 1 !important;
    transform: none !important;

    transition: none !important;
  }

  .lpv-luxury-image > img,
  .lpv-luxury-image:hover > img,
  .lpv-luxury-button,
  .lpv-luxury-button:hover,
  .lpv-luxury-button span,
  .lpv-luxury-button:hover span {
    transform: none !important;
    transition: none !important;
  }
}



/* LPV — LUXURY ALIVE V1 */

/* ---------------------------------------------------------
   HERO — respiration lente
   --------------------------------------------------------- */

.lpv-hero-breathe {
  transform: scale(1.035);
  animation: lpvHeroBreathe 14s ease-in-out infinite alternate;
  will-change: transform;
}

@keyframes lpvHeroBreathe {
  0% {
    transform: scale(1.035) translate3d(0,0,0);
  }

  100% {
    transform: scale(1.065) translate3d(0, -0.2%, 0);
  }
}


/* ---------------------------------------------------------
   CE SOIR — image vivante au hover
   --------------------------------------------------------- */

.lpv-cinematic-image {
  overflow: hidden;
}

.lpv-cinematic-image img {
  transform: scale(1);
  transition:
    transform 1600ms cubic-bezier(.16,1,.3,1),
    filter 900ms ease;
}

.lpv-cinematic-image:hover img {
  transform: scale(1.075);
}


/* ---------------------------------------------------------
   BOUTEILLES — mouvement organique
   --------------------------------------------------------- */

.lpv-bottle-motion {
  transition:
    opacity 800ms ease,
    transform 1200ms cubic-bezier(.22,.61,.36,1);
}

/*
   On anime le contenu intérieur plutôt que le Link,
   afin de ne pas casser le reveal d'entrée.
*/

.lpv-bottle-motion > div {
  will-change: transform;
}

.lpv-reveal.is-visible .lpv-bottle-motion:nth-child(1) > div {
  animation: lpvBottleFloatOne 6.8s ease-in-out 1.1s infinite;
}

.lpv-reveal.is-visible .lpv-bottle-motion:nth-child(2) > div {
  animation: lpvBottleFloatTwo 7.4s ease-in-out 1.5s infinite;
}

.lpv-reveal.is-visible .lpv-bottle-motion:nth-child(3) > div {
  animation: lpvBottleFloatThree 7s ease-in-out 1.9s infinite;
}

@keyframes lpvBottleFloatOne {
  0%, 100% {
    transform: translate3d(0,0,0);
  }

  50% {
    transform: translate3d(0,-6px,0);
  }
}

@keyframes lpvBottleFloatTwo {
  0%, 100% {
    transform: translate3d(0,0,0);
  }

  50% {
    transform: translate3d(0,-3px,0);
  }
}

@keyframes lpvBottleFloatThree {
  0%, 100% {
    transform: translate3d(0,0,0);
  }

  50% {
    transform: translate3d(0,-3px,0);
  }
}


/* ---------------------------------------------------------
   À DÉCOUVRIR — profondeur
   --------------------------------------------------------- */

.lpv-discovery-row {
  transition: transform 700ms cubic-bezier(.16,1,.3,1);
}

@media (hover: hover) and (pointer: fine) {

  .lpv-discovery-row:hover {
    transform: translate3d(0,-1px,0);
  }

  .lpv-discovery-row .lpv-luxury-image img {
    transform: scale(1);
    transition:
      transform 1650ms cubic-bezier(.16,1,.3,1),
      filter 1000ms ease;
  }

  .lpv-discovery-row:hover .lpv-luxury-image img {
    transform: scale(1.025);
  }

  .lpv-discovery-row .lpv-discovery-copy {
    transition:
      opacity 850ms ease 220ms,
      transform 1150ms cubic-bezier(.22,.61,.36,1) 220ms;
  }

  .lpv-discovery-row.is-visible:hover .lpv-discovery-copy {
    transform: translate3d(0,-3px,0);
  }
}


/* ---------------------------------------------------------
   BOUTONS — vraie petite réaction premium
   --------------------------------------------------------- */

.lpv-luxury-button {
  transform-origin: center;
}

.lpv-luxury-button:hover {
  transform: translate3d(0,-4px,0) scale(1.025);
}

.lpv-luxury-button:hover span {
  transform: translateX(9px);
}


/* ---------------------------------------------------------
   ACCESSIBILITÉ
   --------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  .lpv-hero-breathe,
  .lpv-reveal.is-visible .lpv-bottle-motion:nth-child(1) > div,
  .lpv-reveal.is-visible .lpv-bottle-motion:nth-child(2) > div,
  .lpv-reveal.is-visible .lpv-bottle-motion:nth-child(3) > div {
    animation: none !important;
  }

  .lpv-hero-breathe,
  .lpv-cinematic-image img,
  .lpv-cinematic-image:hover img,
  .lpv-discovery-row,
  .lpv-discovery-row:hover,
  .lpv-discovery-row .lpv-luxury-image img,
  .lpv-discovery-row:hover .lpv-luxury-image img {
    transform: none !important;
    transition: none !important;
  }
}

