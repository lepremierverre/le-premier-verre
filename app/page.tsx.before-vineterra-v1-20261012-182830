import Link from "next/link";
import type { SanityImageSource } from "@sanity/image-url";

import { client } from "@/sanity/lib/client";
import { urlFor } from "@/sanity/lib/image";
import { articlesQuery, guidesQuery } from "@/sanity/lib/queries";
import BottleStage from "@/components/wine/BottleStage";

export const revalidate = 60;

type HomeArticle = {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  coverImage?: SanityImageSource;
};

type HomeGuide = {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  coverImage?: SanityImageSource;
  guideType?: string;
  difficulty?: string;
  estimatedReadingTime?: string;
};

type FeaturedWine = {
  name: string;
  slug: string;
  vintage?: number;
  beverageType?: "wine" | "cider";
  alcoholFree?: boolean;
  color?: string;
  bottleImage?: SanityImageSource;
  producer?: {
    name?: string;
  };
};

function Photo({
  src,
  alt,
  className = "",
}: {
  src: string;
  alt: string;
  className?: string;
}) {
  return (
    <img
      src={src}
      alt={alt}
      className={`h-full w-full object-cover ${className}`}
    />
  );
}

export default async function HomePage() {
  const homeWines = await client.fetch<FeaturedWine[]>(
    `*[_type == "wine" && published == true] | order(_updatedAt desc)[0...4] {
      name,
      "slug": slug.current,
      vintage,
      beverageType,
      alcoholFree,
      color,
      bottleImage,
      producer->{name}
    }`
  );

  const featuredWine = homeWines[0] ?? null;
  const selectionWines = homeWines.slice(1, 4);

  const articles = await client.fetch<HomeArticle[]>(articlesQuery);
  const featuredArticle = articles[0] ?? null;

  const guides = await client.fetch<HomeGuide[]>(guidesQuery);
  const featuredGuide = guides[0] ?? null;

  const bottleImage = featuredWine?.bottleImage
    ? urlFor(featuredWine.bottleImage)
        .width(900)
        .height(1000)
        .fit("max")
        .url()
    : null;

  const featuredProducer = await client.fetch<{
    name: string;
    slug: string;
    municipality?: string;
    oneLiner?: string;
    heroImage?: SanityImageSource;
  } | null>(
    `*[
      _type == "producer" &&
      published == true &&
      lpvPartner == true &&
      defined(slug.current)
    ] | order(_updatedAt desc)[0] {
      name,
      "slug": slug.current,
      municipality,
      oneLiner,
      heroImage
    }`
  );

  return (
    <main className="bg-[var(--lpv-paper)] text-[var(--lpv-ink)]">
          {/* HERO */}
          <section className="relative min-h-[78vh] overflow-hidden">
            <Photo
              src="/images/lpv/table-vin.jpg"
              alt="Des amis réunis autour d’une table et de bouteilles de vin"
              className="absolute inset-0 grayscale"
            />

            <div className="absolute inset-0 bg-black/38" />

            <div className="lpv-container relative z-10 flex min-h-[78vh] flex-col justify-end pb-10 pt-24 text-[var(--lpv-paper-light)] md:pb-10">
              <p className="lpv-kicker mb-6 text-white/72">
                Le Premier Verre
              </p>

              <h1 className="lpv-display max-w-5xl text-[clamp(4rem,15vw,5.2rem)] md:text-[clamp(4.6rem,11vw,10.5rem)] leading-[0.82]">
                Boire moins
                <br />
                compliqué.
              </h1>

              <div className="mt-10 border-t border-white/35 pt-6 md:grid md:grid-cols-[0.8fr_1.2fr] md:gap-20">
                <p className="max-w-md text-xl font-medium leading-[1.15] text-white md:text-[1.4rem]">
                  On aime le vin.
                  <br />
                  Pas tout ce qui vient parfois avec.
                </p>

                <div className="mt-5 max-w-2xl text-sm leading-6 text-white/82 md:mt-0 md:text-[15px] md:leading-6">
                  <p>
                    Le Premier Verre est né de l’envie de rendre le vin plus facile
                    à choisir, à comprendre et surtout à découvrir. Ici, on part
                    d’une bouteille, d’un repas, d’une adresse, d’un producteur ou
                    simplement d’une envie.
                  </p>

                  <p className="mt-3">
                    On cherche, on goûte et on rassemble ce qui mérite d’être
                    découvert pour vous aider à construire vos propres repères,
                    garder ce que vous aimez et en découvrir toujours un peu plus.
                  </p>
                </div>
              </div>
        </div>
      </section>

      {/* BLOC ÉDITORIAL */}
      <section>
        <div className="lpv-container grid gap-0 py-8 md:grid-cols-2 md:py-[3.5vw]">
          <div className="h-[280px] overflow-hidden sm:h-[330px] md:h-[460px] md:min-h-0">
            <Photo
              src="/images/lpv/bouteille-ce-soir.jpg"
              alt="Moment de table autour du vin"
              className="transition duration-700 hover:scale-[1.015]"
            />
          </div>

          <div className="flex flex-col border-t border-[var(--lpv-line)] px-0 py-8 md:border-t-0 md:px-12 md:py-12 lg:px-16">
            <div>
              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                Commencer ici
              </p>

              <h2 className="lpv-display mt-5 text-[clamp(3.15rem,13vw,4rem)] leading-[0.9] md:mt-8 md:text-[clamp(3.7rem,6vw,6.5rem)]">
                Une bouteille
                <br />
                pour ce soir.
              </h2>

              <p className="mt-6 max-w-lg text-base leading-7 text-[var(--lpv-muted)] md:mt-8 md:leading-8">
                Choisis selon le repas, l’ambiance ou simplement l’envie du
                moment. Pas besoin de connaître tous les mots.
              </p>
            </div>

            <div className="mt-8 border-t border-[var(--lpv-line)] pt-5 md:mt-10 md:pt-6">
              <Link href="/ce-soir" className="lpv-text-link w-fit">
                Ce soir, on boit quoi? <span>→</span>
              </Link>
            </div>
          </div>
        </div>
      </section>

      {/* SÉLECTION DU MOMENT */}
      <section className="lpv-container py-10 md:pb-12 md:pt-14">
        <div className="mb-7 flex flex-col gap-5 border-b border-[var(--lpv-line)] pb-5 md:mb-8 md:gap-6 md:pb-5 md:flex-row md:items-end md:justify-between">
          <div>
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              Sélection du moment
            </p>

            <h2 className="lpv-display mt-4 max-w-3xl text-[clamp(2.5rem,9vw,3.3rem)] leading-[0.95] md:mt-5 md:text-[clamp(3rem,4.5vw,4.7rem)] md:leading-[0.92]">
              Trois bouteilles qu’on ouvrirait maintenant.
            </h2>
          </div>

          <Link href="/vins" className="lpv-text-link w-fit">
            Voir toute la sélection <span>→</span>
          </Link>
        </div>

        <div className="grid gap-8 md:grid-cols-3 md:gap-10">
          {selectionWines.map((wine) => {
            const image = wine.bottleImage
              ? urlFor(wine.bottleImage)
                  .ignoreImageParams()
                  .width(900)
                  .height(1000)
                  .fit("max")
                  .url()
              : null;

            return (
              <Link
                key={wine.slug}
                href={`/vins/${wine.slug}`}
                className="group md:flex md:h-full md:flex-col"
              >
                <div className="h-[250px] sm:h-[280px] md:h-[330px]">
                  <BottleStage
                    image={wine.bottleImage}
                    alt={wine.name}
                    color={wine.beverageType === "cider" ? undefined : wine.color}
                    variant="card"
                    className="!h-[250px] [&>div]:!h-[220px] [&_img]:!max-w-[68%] sm:!h-[280px] sm:[&>div]:!h-[250px] md:!h-[330px] md:[&>div]:!h-[300px] md:[&_img]:!max-h-[300px] md:[&_img]:!max-w-[62%] transition duration-700 group-hover:scale-[1.02]"
                  />
                </div>

                <div className="border-t border-[var(--lpv-line)] pt-4 md:flex md:flex-1 md:flex-col md:pt-5">
                  <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                    {[
                      wine.beverageType === "cider"
                        ? "Cidre"
                        : wine.color || "Vin",
                      wine.alcoholFree ? "Sans alcool" : null,
                    ]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>

                  <h3 className="lpv-display mt-3 text-[1.65rem] leading-[0.98] md:mt-4 md:text-[1.7rem]">
                    {wine.name}
                  </h3>

                  {wine.producer?.name ? (
                    <p className="mt-2 text-sm leading-6 text-[var(--lpv-muted)] md:mt-3">
                      {wine.producer.name}
                      {wine.vintage ? ` · ${wine.vintage}` : ""}
                    </p>
                  ) : null}

                </div>
              </Link>
            );
          })}
        </div>
      </section>

      {/* À DÉCOUVRIR */}
      <section>
        <div className="lpv-container pb-14 pt-8 md:pb-16 md:pt-10">
          <div className="mb-9 md:mb-11">
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              À découvrir
            </p>

            <h2 className="lpv-display mt-3 text-[clamp(2.6rem,8vw,3.4rem)] leading-[0.92] md:text-[clamp(3rem,4vw,4.4rem)]">
              À lire, à boire,
              <br />
              à connaître.
            </h2>
          </div>

          <div className="grid gap-10 md:grid-cols-3 md:gap-7 lg:gap-9">
            {/* PRODUCTEUR */}
            {featuredProducer ? (
              <Link
                href={`/producteurs/${featuredProducer.slug}`}
                className="group flex flex-col"
              >
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Producteur
                </p>

                {featuredProducer.heroImage ? (
                  <div className="mt-5 aspect-[4/3] overflow-hidden bg-[var(--lpv-paper-light)]">
                    <img
                      src={urlFor(featuredProducer.heroImage)
                        .width(900)
                        .height(675)
                        .fit("crop")
                        .url()}
                      alt={featuredProducer.name}
                      className="h-full w-full object-cover transition duration-700 group-hover:scale-[1.015]"
                    />
                  </div>
                ) : null}

                <h3 className="lpv-display mt-5 text-[2rem] leading-[0.95] md:text-[2.35rem]">
                  {featuredProducer.name}
                </h3>

                {featuredProducer.municipality ? (
                  <p className="lpv-kicker mt-3 text-[var(--lpv-cocoa)]">
                    {featuredProducer.municipality}
                  </p>
                ) : null}

              </Link>
            ) : null}

            {/* GUIDE */}
            {featuredGuide ? (
              <Link
                href={`/guides/${featuredGuide.slug}`}
                className="group flex flex-col"
              >
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Guide
                </p>

                {featuredGuide.coverImage ? (
                  <div className="mt-5 aspect-[4/3] overflow-hidden bg-[var(--lpv-paper-light)]">
                    <img
                      src={urlFor(featuredGuide.coverImage)
                        .width(900)
                        .height(675)
                        .fit("crop")
                        .url()}
                      alt={featuredGuide.title}
                      className="h-full w-full object-cover transition duration-700 group-hover:scale-[1.015]"
                    />
                  </div>
                ) : null}

                <h3 className="lpv-display mt-5 text-[2rem] leading-[0.95] md:text-[2.35rem]">
                  {featuredGuide.title}
                </h3>

              </Link>
            ) : null}

            {/* JOURNAL */}
            {featuredArticle ? (
              <Link
                href={`/blog/${featuredArticle.slug}`}
                className="group flex flex-col"
              >
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Journal
                </p>

                {featuredArticle.coverImage ? (
                  <div className="mt-5 aspect-[4/3] overflow-hidden bg-[var(--lpv-paper-light)]">
                    <img
                      src={urlFor(featuredArticle.coverImage)
                        .width(900)
                        .height(675)
                        .fit("crop")
                        .url()}
                      alt={featuredArticle.title}
                      className="h-full w-full object-cover transition duration-700 group-hover:scale-[1.015]"
                    />
                  </div>
                ) : null}

                <h3 className="lpv-display mt-5 text-[2rem] leading-[0.95] md:text-[2.35rem]">
                  {featuredArticle.title}
                </h3>

              </Link>
            ) : null}
          </div>

        </div>
      </section>

      {/* NEWSLETTER */}
      <section className="bg-[var(--lpv-cocoa)] text-[var(--lpv-paper-light)]">
        <div className="lpv-container grid gap-0 py-16 md:grid-cols-[0.8fr_1.2fr] md:py-24">
          <div className="overflow-hidden">
            <Photo
              src="/images/lpv/infolettre.jpg"
              alt="Paysage viticole du Premier Verre"
              className="aspect-[4/5]"
            />
          </div>

          <div className="flex flex-col justify-center border-white/20 pt-10 md:border-l md:px-14 md:pt-0 lg:px-20">
            <p className="lpv-kicker text-white/55">
              L’infolettre
            </p>

            <h2 className="lpv-display mt-8 max-w-3xl text-[clamp(4rem,7vw,7.5rem)] leading-[0.86]">
              Avant le
              <br />
              week-end.
            </h2>

            <p className="mt-8 max-w-xl text-base leading-8 text-white/68">
              Une bouteille, une adresse et une idée à garder sous la main.
            </p>

            <Link
              href="/newsletter"
              className="lpv-text-link mt-10 w-fit text-white"
            >
              S’inscrire <span>→</span>
            </Link>
          </div>
        </div>
      </section>
    </main>
  );
}
