                    <p className="mx-auto mt-5 max-w-[520px] text-[0.95rem] leading-7 text-[var(--lpv-muted)]">
                      Notre sélection de bouteilles à découvrir chez Beyt
                      arrive bientôt.
                    </p>
                  </div>
                </div>
              )}
            </div>
          </section>

          {/* VISITER */}
          <section className="border-t border-[var(--lpv-line)] pb-3 pt-10 md:pb-4 md:pt-14">
            <div className="grid gap-10 md:grid-cols-[0.42fr_0.58fr] md:gap-16">
              <div>
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Y aller
                </p>

                <h2 className="lpv-display mt-4 text-[clamp(3.2rem,4.8vw,5.4rem)] leading-[0.87] tracking-[-0.045em]">
