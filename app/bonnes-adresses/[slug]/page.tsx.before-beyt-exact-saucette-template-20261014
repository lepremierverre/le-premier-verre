            </div>
          ) : (
            <div className="max-w-6xl">
              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                {[
                  formatType(place.type),
                  place.city,
                ].filter(Boolean).join(" · ")}
              </p>

              <h1 className="lpv-display mt-7 max-w-7xl text-[clamp(4rem,8vw,8rem)] leading-[0.82] tracking-[-0.055em]">
                {place.name}
