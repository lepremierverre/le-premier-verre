                      Visiter le site →
                    </a>
                  </div>
                ) : null}

                {place.instagram ? (
                  <div>
                    <p className="text-[0.55rem] font-semibold uppercase tracking-[0.17em] text-[var(--lpv-cocoa)]">
                      Instagram
                    </p>

                    <a
                      href={place.instagram}
                      target="_blank"
                      rel="noreferrer"
                      className="mt-2 inline-flex text-sm text-[var(--lpv-ink)] underline decoration-[0.05em] underline-offset-[3px] transition-opacity hover:opacity-55"
                    >
                      Instagram →
                    </a>
                  </div>
                ) : null}
              </div>
            </div>
          </section>

        </article>
      </main>
    );
  }

