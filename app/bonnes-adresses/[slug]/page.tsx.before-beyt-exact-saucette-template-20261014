                  </p>

                  <p className="mt-2 text-sm leading-6 text-[var(--lpv-muted)]">
                    Montréal
                  </p>
                </div>

                {place.address ? (
                  <div>
                    <p className="text-[0.55rem] font-semibold uppercase tracking-[0.17em] text-[var(--lpv-cocoa)]">
                      Adresse
                    </p>

                    <p className="mt-2 text-sm leading-6 text-[var(--lpv-muted)]">
                      {place.address}
                    </p>
                  </div>
                ) : null}

                {place.website ? (
                  <div>
                    <p className="text-[0.55rem] font-semibold uppercase tracking-[0.17em] text-[var(--lpv-cocoa)]">
                      Site
