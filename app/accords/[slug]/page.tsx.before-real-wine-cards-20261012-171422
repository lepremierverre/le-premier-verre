                      {wine.producer ? (
                        <p className="mt-2 text-sm text-[var(--lpv-muted)]">
                          {wine.producer}
                        </p>
                      ) : null}

                      <div className="mt-5 space-y-2 border-t border-[var(--lpv-line)] pt-4">
                        {wine.reasons.map((reason) => (
