          className="absolute inset-0 h-full w-full object-cover grayscale"
        />
        <div className="absolute inset-0 bg-black/38" />

        <div className="lpv-container relative z-10 flex min-h-[82vh] flex-col justify-end pb-8 pt-24 text-[var(--lpv-paper-light)] md:pb-10">
