                <div className="grid gap-4 border-b border-[var(--lpv-line)] py-5 md:grid-cols-[1fr_auto]">
                  <div>
                    <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                      Producteur en vedette
                    </p>

                    <h3 className="lpv-display mt-3 text-[clamp(2.7rem,5vw,4.3rem)] leading-[0.88]">
