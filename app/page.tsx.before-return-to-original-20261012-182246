import Link from "next/link";
import type { SanityImageSource } from "@sanity/image-url";

import { client } from "@/sanity/lib/client";
import { urlFor } from "@/sanity/lib/image";
import {
  articlesQuery,
  guidesQuery,
  placesQuery,
  producersQuery,
} from "@/sanity/lib/queries";
import BottleStage from "@/components/wine/BottleStage";

export const revalidate = 60;

type HomeArticle = {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  category?: string;
  coverImage?: SanityImageSource;
};

type HomeGuide = {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  coverImage?: SanityImageSource;
  guideType?: string;
  difficulty?: string;
  estimatedReadingTime?: string;
};

type FeaturedWine = {
  _id: string;
  name: string;
  slug: string;
  vintage?: number;
  beverageType?: "wine" | "cider";
  alcoholFree?: boolean;
  color?: string;
  bottleImage?: SanityImageSource;
  producer?: { name?: string };
  country?: { name?: string; slug?: string };
  region?: { name?: string; slug?: string };
};

type HomeProducer = {
  _id: string;
  name: string;
  slug: string;
  municipality?: string;
  oneLiner?: string;
  shortBio?: string;
  photo?: SanityImageSource;
  heroImage?: SanityImageSource;
  lpvPartner?: boolean;
  mediaPermissionStatus?: string;
  country?: { name?: string; slug?: string };
  region?: { name?: string; slug?: string };
};

type HomePlace = {
  _id: string;
  name: string;
  slug: string;
  type?: string;
  city?: string;
  region?: string;
  highlights?: string[];
  coverImage?: SanityImageSource;
  lpvPartner?: boolean;
  mediaPermissionStatus?: string;
  mediaCredit?: string;
};

const AUTHORIZED_MEDIA = new Set([
  "provided_by_place",
  "authorized_by_place",
  "lpv_original",
  "licensed",
]);

function isQuebecWine(wine: FeaturedWine) {
  const values = [
    wine.country?.name,
    wine.country?.slug,
    wine.region?.name,
    wine.region?.slug,
  ]
    .filter(Boolean)
    .map((value) => value!.trim().toLowerCase());

  return values.some(
    (value) =>
      value === "québec" ||
      value === "quebec" ||
      value.includes("québec") ||
      value.includes("quebec"),
  );
}

function placeType(type?: string) {
  const labels: Record<string, string> = {
    restaurant: "Restaurant",
    "wine-bar": "Bar à vin",
    caviste: "Caviste",
    shop: "Boutique",
    vineyard: "Vignoble",
    winery: "Vignoble",
    other: "Bonne adresse",
  };

  return type ? labels[type] || type : "Bonne adresse";
}

function locationLine(...parts: Array<string | undefined>) {
  return parts.filter(Boolean).join(" · ");
}

export default async function HomePage() {
  const [wines, articles, guides, producers, places] = await Promise.all([
    client.fetch<FeaturedWine[]>(
      `*[
        _type == "wine" &&
        published == true &&
        defined(slug.current) &&
        !(_id in path("drafts.**"))
      ] | order(_updatedAt desc)[0...50] {
        _id,
        name,
        "slug": slug.current,
        vintage,
        beverageType,
        alcoholFree,
        color,
        bottleImage,
        producer->{name},
        country->{name, "slug": slug.current},
        region->{name, "slug": slug.current}
      }`,
    ),
    client.fetch<HomeArticle[]>(articlesQuery),
    client.fetch<HomeGuide[]>(guidesQuery),
    client.fetch<HomeProducer[]>(producersQuery),
    client.fetch<HomePlace[]>(placesQuery),
  ]);

  /*
   * Editorial push:
   * Québec first, international remains fully available in /vins.
   */
  const quebecWines = wines.filter(isQuebecWine);
  const internationalWines = wines.filter((wine) => !isQuebecWine(wine));
  const selectionWines = [...quebecWines, ...internationalWines].slice(0, 3);

  /*
   * Prefer LPV partners editorially without excluding the rest of the directory.
   */
  const sortedProducers = [...producers].sort(
    (a, b) => Number(Boolean(b.lpvPartner)) - Number(Boolean(a.lpvPartner)),
  );

  const featuredProducer = sortedProducers[0] ?? null;
  const secondaryProducers = sortedProducers.slice(1, 4);

  /*
   * Only use place photography when LPV has a recognized media status.
   */
  const editorialPlaces = [...places].sort((a, b) => {
    const aScore =
      Number(Boolean(a.lpvPartner)) * 2 +
      Number(Boolean(a.coverImage && AUTHORIZED_MEDIA.has(a.mediaPermissionStatus || "")));
    const bScore =
      Number(Boolean(b.lpvPartner)) * 2 +
      Number(Boolean(b.coverImage && AUTHORIZED_MEDIA.has(b.mediaPermissionStatus || "")));

    return bScore - aScore;
  });

  const featuredPlace = editorialPlaces[0] ?? null;
  const secondaryPlaces = editorialPlaces.slice(1, 3);

  const featuredPlaceImage =
    featuredPlace?.coverImage &&
    AUTHORIZED_MEDIA.has(featuredPlace.mediaPermissionStatus || "")
      ? urlFor(featuredPlace.coverImage)
          .width(1500)
          .height(1900)
          .fit("crop")
          .url()
      : null;

