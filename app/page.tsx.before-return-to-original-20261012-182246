            </div>
          </div>
        </section>
      ) : null}

      {/* ======================================================
          BONNES ADRESSES
      ====================================================== */}
      {featuredPlace ? (
        <section className="bg-[var(--lpv-paper-light)]">
          <div className="lpv-container py-14 md:py-24">
            <div className="mb-10 grid gap-5 border-t border-[var(--lpv-line)] pt-5 md:grid-cols-2 md:items-end">
              <div>
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Bonnes adresses
                </p>

                <h2 className="lpv-display mt-5 text-[clamp(4rem,10vw,7rem)] leading-[0.82] tracking-[-0.05em]">
                  Où boire
                  <br />
                  quelque chose
                  <br />
                  de bon.
                </h2>
              </div>

              <div className="md:flex md:justify-end">
                <Link href="/bonnes-adresses" className="lpv-text-link w-fit">
                  Toutes les adresses <span>→</span>
                </Link>
              </div>
            </div>

            <div className="grid gap-8 md:grid-cols-12 md:items-start">
