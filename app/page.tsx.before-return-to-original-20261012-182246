                    {featuredProducer.municipality ? (
                      <p className="mt-3 text-xs uppercase tracking-[0.14em] text-[var(--lpv-muted)]">
                        {featuredProducer.municipality}
                      </p>
                    ) : null}
                  </div>

                  <span className="hidden self-end text-xl md:block">↗</span>
                </div>

                {featuredProducer.oneLiner ? (
