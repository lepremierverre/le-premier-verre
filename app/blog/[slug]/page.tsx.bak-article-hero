  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;

  const article = await client.fetch<Article | null>(
    articleBySlugQuery,
    { slug }
  );

  if (!article) notFound();

  const imageSrc = article.coverImage
    ? urlFor(article.coverImage)
        .width(2000)
        .height(1400)
        .fit("crop")
        .url()
    : null;

  const tags = parseTags(article);

  const legacyParagraphs =
    typeof article.content === "string"
      ? article.content
          .split(/\n{2,}/)
          .map((paragraph) => paragraph.trim())
          .filter(Boolean)
      : [];

  const portableContentRaw = Array.isArray(article.content)
    ? article.content
    : [];

  // Les CTA de fin sont gérés globalement par le template.
  // On retire donc du contenu Sanity :
  // - les lignes commençant par →
  // - le titre "Pour continuer"
  const portableContent = portableContentRaw.filter((item) => {
    if (item?._type !== "block") return true;

    const block = item as PortableTextBlock;

    const text = block.children
      ?.map((child) => (child._type === "span" ? child.text : ""))
      .join("")
      .trim();

    if (!text) return true;

    if (text.startsWith("→")) {
      return false;
    }

    if (text.toLowerCase() === "pour continuer") {
      return false;
    }

    return true;
  });

  const wineSectionStart = portableContent.findIndex(
    (block) =>
      getBlockText(block).toLowerCase() ===
      "six bouteilles pour commencer"
  );

  const wineSectionEnd = portableContent.findIndex(
    (block, index) =>
      index > wineSectionStart &&
      getBlockText(block).toLowerCase() ===
        "une bouteille que tu n’aimes pas, ça compte aussi"
  );

  const contentBeforeWines =
    wineSectionStart >= 0
      ? portableContent.slice(0, wineSectionStart)
      : portableContent;

  const contentAfterWines =
    wineSectionStart >= 0 && wineSectionEnd >= 0
      ? portableContent.slice(wineSectionEnd)
      : [];

  const wines = article.relatedWines || [];

  return (
    <main className="min-h-screen bg-[var(--lpv-paper)] text-[var(--lpv-ink)]">
      <article className="pb-24">
        <div className="lpv-container pt-8 md:pt-10">
          <Link href="/blog" className="lpv-text-link">
            <span>←</span> Retour au journal
          </Link>
        </div>

        <header className="lpv-container grid gap-12 border-b border-[var(--lpv-line)] pb-16 pt-10 md:pb-24 md:pt-16 lg:grid-cols-[0.82fr_1.18fr]">
          <div className="lg:sticky lg:top-24 lg:self-start">
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              {article.category || "Article"}
            </p>

            <h1 className="lpv-display mt-7 text-[clamp(3.8rem,6.5vw,7rem)] leading-[0.88]">
              {article.title}
            </h1>

            {article.excerpt ? (
              <p className="mt-8 max-w-lg text-lg leading-8 text-[var(--lpv-muted)]">
                {article.excerpt}
              </p>
            ) : null}

            <div className="mt-10 flex flex-wrap gap-4 border-t border-[var(--lpv-line)] pt-7 text-xs uppercase tracking-[0.16em] text-[var(--lpv-muted)]">
              {article.author ? <span>{article.author}</span> : null}

              {formatDate(article.publishedAt || article._createdAt) ? (
                <span>
                  · {formatDate(article.publishedAt || article._createdAt)}
                </span>
              ) : null}
            </div>
          </div>

          <div className="relative min-h-[620px] overflow-hidden bg-[var(--lpv-paper-light)] md:min-h-[780px]">
            {imageSrc ? (
              <img
                src={imageSrc}
                alt={article.title}
                className="absolute inset-0 h-full w-full object-cover"
              />
            ) : (
              <div className="flex min-h-[620px] items-center justify-center">
                <p className="text-sm text-[var(--lpv-muted)]">
                  Image à ajouter dans Sanity.
                </p>
