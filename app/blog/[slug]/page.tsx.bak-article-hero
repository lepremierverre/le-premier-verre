        </header>

        <section className="lpv-container grid gap-10 pt-16 pb-4 md:grid-cols-[0.3fr_0.7fr] md:pt-24 md:pb-6">
          <div>
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              Le journal
            </p>

