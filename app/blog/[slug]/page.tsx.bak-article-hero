                    <p className="text-[var(--lpv-muted)]">
                      Les bouteilles liées seront bientôt affichées ici.
                    </p>
                  )}
                </section>
              ) : null}

              {contentAfterWines.length > 0 ? (
                <PortableText
                  value={contentAfterWines}
                  components={{
                  types: {
                    articleWineCard: ({ value }) => (
                      <ArticleWineCardView
                        value={value as ArticleWineCard}
                      />
                    ),
                    articleProducerCard: ({ value }) => (
                      <ArticleProducerCardView
                        value={value as ArticleProducerCard}
                      />
                    ),
                    articlePlaceCard: ({ value }) => (
                      <ArticlePlaceCardView
                        value={value as ArticlePlaceCard}
                      />
                    ),
                  },
                    block: {
                      normal: ({ children, value }) => {
                        const rawText = value.children
                          ?.map((child) =>
                            child._type === "span" ? child.text : ""
                          )
                          .join("")
                          .trim();

                        const isCTA = rawText?.startsWith("→");
                        const lowerText = rawText?.toLowerCase() || "";

                        // Les CTA de fin d'article sont désormais remplacés
                        // par le bloc Infolettre global du template.
                        if (isCTA) {
                          return null;
                        }

                        const isNewsletter =
                          lowerText.includes("s’inscrire à l’infolettre") ||
                          lowerText.includes("s'inscrire à l'infolettre");

                        const isPrimaryCTA =
                          lowerText.includes("trouver une bouteille") ||
                          lowerText.includes("trouver ma bouteille");

                        const isPersonalCTA =
                          lowerText.includes("ma cave") ||
                          lowerText.includes("mon carnet");

                        if (isNewsletter) {
                          return (
                            <div className="my-16 bg-[var(--lpv-paper-light)] px-7 py-10 md:my-20 md:px-10 md:py-12">
                              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                                L’infolettre
                              </p>

                              <div className="mt-5 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
                                <div>
                                  <p className="lpv-display max-w-2xl text-[clamp(2.8rem,5vw,4.8rem)] leading-[0.9]">
                                    On se reparle autour d’un verre?
                                  </p>

                                  <p className="mt-5 max-w-xl text-base leading-7 text-[var(--lpv-muted)]">
                                    Des bouteilles qu’on a aimées, des producteurs à connaître
                                    et quelques bonnes adresses. Pas tous les jours. Juste quand
                                    on a quelque chose de bon à partager.
                                  </p>
                                </div>

                                <div className="inline-flex w-fit items-center gap-4 bg-[var(--lpv-ink)] px-5 py-4 text-base font-medium text-[var(--lpv-paper)]">
                                  <span>
                                    {rawText.replace(/^→\s*/, "")}
                                  </span>
                                  <span aria-hidden="true">→</span>
                                </div>
                              </div>
                            </div>
                          );
                        }

                        if (isPrimaryCTA) {
                          const href =
                            value.markDefs?.find(
                              (mark: any) => mark._type === "link"
                            )?.href || "/ce-soir";

                          return (
                            <div className="my-8">
                              <Link
                                href={href}
                                className="inline-flex w-fit max-w-full items-center gap-4 bg-[var(--lpv-ink)] px-5 py-4 text-base font-medium text-[var(--lpv-paper)] transition-opacity hover:opacity-85"
                              >
                                <span className="text-base font-medium text-[var(--lpv-paper)]">
                                  Trouver ma bouteille
                                </span>

                                <span
                                  aria-hidden="true"
                                  className="text-lg text-[var(--lpv-paper)]/75"
                                >
                                  →
                                </span>
                              </Link>
                            </div>
                          );
                        }

                        if (isCTA && isPersonalCTA) {
                          return (
                            <div className="my-2 mr-3 inline-block">
                              <Link
                                href={
                                  value.markDefs?.find(
                                    (mark: any) => mark._type === "link"
                                  )?.href || "#"
                                }
                                className="group inline-flex items-center gap-3 border border-[var(--lpv-line)] px-4 py-2.5 text-sm font-medium transition-colors hover:border-[var(--lpv-ink)] md:text-base"
                              >
                                {rawText
                                  .replace(/^→\s*/, "")
                                  .replace(/^Ouvrir\s+/i, "")
                                  .replace(/^Voir\s+/i, "")}

                                <span
                                  aria-hidden="true"
                                  className="text-[var(--lpv-cocoa)] transition-transform group-hover:translate-x-0.5"
                                >
                                  →
                                </span>
                              </Link>
                            </div>
                          );
                        }

                        if (isCTA) {
                          const href =
                            lowerText.includes("explorer les vins")
                              ? "/vins"
                              : lowerText.includes("explorer les cépages")
                                ? "/cepages"
                                : lowerText.includes("découvrir les producteurs")
                                  ? "/producteurs"
                                  : lowerText.includes("ce soir")
                                    ? "/ce-soir"
                                    : lowerText.includes("infolettre")
                                      ? "/newsletter"
                                      : value.markDefs?.find(
                                          (mark: any) => mark._type === "link"
                                        )?.href;

                          if (href) {
                            return (
                              <div className="my-3 max-w-[46rem]">
                                <Link
                                  href={href}
                                  className="inline-flex w-fit max-w-full items-center gap-4 bg-[var(--lpv-ink)] px-5 py-4 text-base font-medium text-[var(--lpv-paper)] transition-opacity hover:opacity-85"
                                >
                                  {children}
                                </Link>
                              </div>
                            );
                          }

                          return (
                            <div className="my-3 max-w-[46rem]">
                              <div className="inline-flex items-center gap-3 border-b border-[var(--lpv-ink)] pb-2 text-lg font-medium">
                                {children}
                              </div>
                            </div>
                          );
                        }

                        return (
                          <p className="mb-6 max-w-[46rem] text-[1.08rem] leading-[1.9] md:text-[1.14rem]">
                            {children}
                          </p>
                        );
                      },

                      h2: ({ children }) => (
                        <div className="mb-9 mt-20 pt-2 md:mt-24">
                          <h2 className="lpv-display max-w-3xl text-[clamp(3rem,6vw,5.5rem)] leading-[0.9]">
                            {children}
                          </h2>
                        </div>
                      ),

                      takeaway: ({ children, value }) => {
                      const rawText = value.children
                        ?.map((child) =>
                          child._type === "span" ? child.text : ""
                        )
                        .join("")
                        .trim();

                      const takeawayText = rawText
                        ?.replace(/^À RETENIR\s*:\s*/i, "")
                        .trim();

                      return (
                        <div className="my-10 max-w-[46rem] border-y border-[var(--lpv-line)] py-5">
                          <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                            À retenir
                          </p>

                          <p className="mt-2 text-base leading-7 text-[var(--lpv-ink)] md:text-[1.05rem]">
                            {takeawayText || children}
                          </p>
                        </div>
                      );
                    },

                    blockquote: ({ children, value }) => {
                        const rawText = value.children
                          ?.map((child) =>
                            child._type === "span" ? child.text : ""
                          )
                          .join("")
                          .trim();

                        if (rawText === "OCCASION + STYLE + BUDGET.") {
                          return (
                            <div className="my-14 border-y border-[var(--lpv-ink)] py-10 md:my-20 md:py-14">
                              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                                Le réflexe à retenir
                              </p>

                              <p className="lpv-display mt-5 text-[clamp(3rem,7vw,6.5rem)] leading-[0.84]">
                                Occasion + Style + Budget
                              </p>
                            </div>
                          );
                        }

                        return (
                          <div className="my-10 max-w-[42rem] md:my-14">
                            <p className="text-xl italic leading-[1.65] text-[var(--lpv-ink)] md:text-2xl">
                              {children}
                            </p>
                          </div>
                        );
                      },
                    },

                    marks: {
                      link: ({ children, value }) => (
                        <Link
                          href={value?.href || "#"}
                          className="font-medium underline decoration-[var(--lpv-cocoa)] underline-offset-4"
                        >
                          {children}
                        </Link>
                      ),
                    },

                    list: {
                      bullet: ({ children }) => (
                        <ul className="my-10 grid gap-3 md:grid-cols-3">
                          {children}
                        </ul>
                      ),
                    },

                    listItem: {
                      bullet: ({ children }) => (
                        <li className="border-t border-[var(--lpv-line)] pt-4 text-lg">
                          {children}
                        </li>
                      ),
                    },
                  }}
                />
              ) : null}
            </div>
          ) : legacyParagraphs.length > 0 ? (
            <div className="lpv-prose max-w-3xl">
              {legacyParagraphs.map((paragraph, index) => (
                <p key={`${index}-${paragraph.slice(0, 24)}`}>
                  {paragraph}
                </p>
              ))}
            </div>
          ) : (
            <p className="text-base leading-8 text-[var(--lpv-muted)]">
              Le contenu détaillé de cet article est en préparation.
            </p>
          )}
        </section>

        <section className="lpv-container py-10 md:py-14">
          <div className="bg-[var(--lpv-paper-light)] px-7 py-10 md:px-10 md:py-12">
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              L’infolettre
            </p>

            <div className="mt-5 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
              <div>
                <p className="lpv-display max-w-2xl text-[clamp(2.8rem,5vw,4.8rem)] leading-[0.9]">
                  On se reparle autour d’un verre?
                </p>

                <p className="mt-5 max-w-xl text-base leading-7 text-[var(--lpv-muted)]">
                  Des bouteilles qu’on a aimées, des producteurs à connaître et
                  quelques bonnes adresses. Pas tous les jours. Juste quand on a
                  quelque chose de bon à partager.
                </p>
              </div>

              <Link
                href="/newsletter"
                className="group inline-flex w-fit items-center gap-3 border-b border-[var(--lpv-ink)] pb-2 text-base font-medium text-[var(--lpv-ink)] transition-opacity hover:opacity-60"
              >
                <span>S’inscrire à l’infolettre</span>
                <span
                  aria-hidden="true"
                  className="transition-transform group-hover:translate-x-1"
                >
                  →
                </span>
              </Link>
            </div>
          </div>
        </section>

        {tags.length > 0 ? (
          <section className="lpv-container py-8 md:py-10">
            <div className="flex flex-col gap-5 md:flex-row md:items-center md:gap-8">
              <p className="lpv-kicker shrink-0 text-[var(--lpv-cocoa)]">
                Dans cet article
              </p>

              <div className="flex flex-wrap gap-x-3 gap-y-2">
                {tags.map((tag, index) => (
                  <span
                    key={tag}
                    className="text-base text-[var(--lpv-muted)]"
                  >
                    {tag}
                    {index < tags.length - 1 ? (
                      <span className="ml-3 text-[var(--lpv-line)]">•</span>
                    ) : null}
                  </span>
                ))}
              </div>
            </div>
          </section>
        ) : null}

        <section className="lpv-container pt-10 pb-20 md:pt-14 md:pb-24">
          <div className="pt-4">
            <p className="lpv-kicker text-[var(--lpv-cocoa)]">
              La suite
            </p>

            <Link href="/blog" className="group mt-6 block">
              <h2 className="lpv-display max-w-4xl text-5xl leading-[0.9] transition-opacity group-hover:opacity-60 md:text-7xl">
                À découvrir ensuite
              </h2>

              <p className="mt-6 max-w-xl text-lg leading-8 text-[var(--lpv-muted)]">
                D’autres bouteilles, des producteurs, des endroits et quelques
                détours pour continuer à découvrir le vin sans en faire un examen.
              </p>

              <span className="lpv-text-link mt-8">
                Continuer dans le journal <span>→</span>
              </span>
            </Link>
          </div>
        </section>
      </article>
    </main>
  );
}
