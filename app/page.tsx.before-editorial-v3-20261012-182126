              <h2 className="lpv-display mt-4 max-w-3xl text-[clamp(2.5rem,9vw,3.3rem)] leading-[0.95] md:mt-5 md:text-[clamp(3rem,4.5vw,4.7rem)] md:leading-[0.92]">
