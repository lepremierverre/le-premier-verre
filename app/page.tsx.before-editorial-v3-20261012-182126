import Link from "next/link";
import type { SanityImageSource } from "@sanity/image-url";

import { client } from "@/sanity/lib/client";
import { urlFor } from "@/sanity/lib/image";
import { articlesQuery, guidesQuery } from "@/sanity/lib/queries";
import BottleStage from "@/components/wine/BottleStage";

export const revalidate = 60;

type HomeArticle = {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  coverImage?: SanityImageSource;
};

type HomeGuide = {
  _id: string;
  title: string;
  slug: string;
  excerpt?: string;
  coverImage?: SanityImageSource;
  guideType?: string;
  difficulty?: string;
  estimatedReadingTime?: string;
};

type FeaturedWine = {
  _id: string;
  name: string;
  slug: string;
  vintage?: number;
  beverageType?: "wine" | "cider";
  alcoholFree?: boolean;
  color?: string;
  bottleImage?: SanityImageSource;
  producer?: {
    name?: string;
  };
  country?: {
    name?: string;
    slug?: string;
  };
  region?: {
    name?: string;
    slug?: string;
  };
};

type FeaturedProducer = {
  name: string;
  slug: string;
  municipality?: string;
  oneLiner?: string;
  heroImage?: SanityImageSource;
};

type FeaturedPlace = {
  _id: string;
  name: string;
  slug: string;
  type?: string;
  city?: string;
  region?: string;
  highlights?: string[];
  coverImage?: SanityImageSource;
  lpvPartner?: boolean;
  mediaPermissionStatus?:
    | "none"
    | "provided_by_place"
    | "authorized_by_place"
    | "lpv_original"
    | "licensed";
  mediaCredit?: string;
};

const AUTHORIZED_MEDIA_STATUSES = [
  "provided_by_place",
  "authorized_by_place",
  "lpv_original",
  "licensed",
];

function Photo({
  src,
  alt,
  className = "",
}: {
  src: string;
  alt: string;
  className?: string;
}) {
  return (
    <img
      src={src}
      alt={alt}
      className={`h-full w-full object-cover ${className}`}
    />
  );
}

function formatPlaceType(value?: string) {
  const labels: Record<string, string> = {
    restaurant: "Restaurant",
    "wine-bar": "Bar à vin",
    caviste: "Caviste",
    shop: "Boutique",
    other: "Bonne adresse",
  };

  return value ? labels[value] || value : "Bonne adresse";
}

function isQuebecWine(wine: FeaturedWine) {
  const country = wine.country?.name?.trim().toLowerCase() || "";
  const countrySlug = wine.country?.slug?.trim().toLowerCase() || "";
  const region = wine.region?.name?.trim().toLowerCase() || "";
  const regionSlug = wine.region?.slug?.trim().toLowerCase() || "";

  return (
    region === "québec" ||
    region === "quebec" ||
    regionSlug === "quebec" ||
    regionSlug === "québec" ||
    country === "québec" ||
    country === "quebec" ||
    countrySlug === "quebec" ||
    countrySlug === "québec"
  );
}

export default async function HomePage() {
  const [
    homeWines,
    articles,
    guides,
    featuredProducer,
    featuredPlace,
  ] = await Promise.all([
    client.fetch<FeaturedWine[]>(
      `*[
        _type == "wine" &&
        published == true &&
        defined(slug.current) &&
        !(_id in path("drafts.**"))
      ] | order(_updatedAt desc)[0...40] {
        _id,
        name,
        "slug": slug.current,
        vintage,
        beverageType,
        alcoholFree,
        color,
        bottleImage,
        producer->{name},
        country->{name, "slug": slug.current},
        region->{name, "slug": slug.current}
      }`,
    ),

    client.fetch<HomeArticle[]>(articlesQuery),

    client.fetch<HomeGuide[]>(guidesQuery),

    client.fetch<FeaturedProducer | null>(
      `*[
        _type == "producer" &&
        published == true &&
        lpvPartner == true &&
        defined(slug.current) &&
        !(_id in path("drafts.**"))
      ] | order(_updatedAt desc)[0] {
        name,
        "slug": slug.current,
        municipality,
        oneLiner,
        heroImage
      }`,
    ),

    client.fetch<FeaturedPlace | null>(
      `*[
        _type == "place" &&
        published == true &&
        lpvPartner == true &&
        defined(slug.current) &&
        mediaPermissionStatus in [
          "provided_by_place",
          "authorized_by_place",
          "lpv_original",
          "licensed"
        ] &&
        defined(coverImage) &&
        !(_id in path("drafts.**"))
      ] | order(_updatedAt desc)[0] {
        _id,
        name,
        "slug": slug.current,
        type,
        city,
        region,
        highlights,
        coverImage,
        lpvPartner,
        mediaPermissionStatus,
        mediaCredit
      }`,
    ),
  ]);

  const quebecWines = homeWines.filter(isQuebecWine);
  const otherWines = homeWines.filter((wine) => !isQuebecWine(wine));

  const selectionWines = [...quebecWines, ...otherWines].slice(0, 3);

  const featuredArticle = articles[0] ?? null;
  const featuredGuide = guides[0] ?? null;

  const placeHasAuthorizedImage =
    featuredPlace?.coverImage &&
    AUTHORIZED_MEDIA_STATUSES.includes(
      featuredPlace.mediaPermissionStatus || "",
    );

  const featuredPlaceImage =
    featuredPlace && placeHasAuthorizedImage
      ? urlFor(featuredPlace.coverImage!)
          .width(1800)
          .height(1200)
          .fit("crop")
          .url()
      : null;

  const featuredPlaceLocation = featuredPlace
    ? [featuredPlace.city, featuredPlace.region].filter(Boolean).join(" · ")
    : "";

  return (
    <main className="overflow-hidden bg-[var(--lpv-paper)] text-[var(--lpv-ink)]">
      {/* HERO */}
      <section className="relative min-h-[82vh] overflow-hidden">
        <Photo
          src="/images/lpv/table-vin.jpg"
          alt="Des amis réunis autour d’une table et de bouteilles de vin"
          className="absolute inset-0 scale-[1.025] grayscale"
        />

        <div className="absolute inset-0 bg-black/40" />

        <div className="lpv-container relative z-10 flex min-h-[82vh] flex-col justify-end pb-10 pt-24 text-[var(--lpv-paper-light)]">
          <>
            <p className="lpv-kicker mb-6 text-white/72">
              Le Premier Verre
            </p>
          </>

          <div className="overflow-hidden">
            <>
              <h1 className="lpv-display max-w-5xl text-[clamp(4rem,15vw,5.2rem)] leading-[0.82] md:text-[clamp(4.6rem,11vw,10.5rem)]">
                Boire moins
                <br />
                compliqué.
              </h1>
            </>
          </div>

          <>
            <div className="mt-10 border-t border-white/35 pt-6 md:grid md:grid-cols-[0.8fr_1.2fr] md:gap-20">
              <p className="max-w-md text-xl font-medium leading-[1.15] text-white md:text-[1.4rem]">
                Le vin,
                <br />
                vu d’ici.
              </p>

              <div className="mt-5 max-w-2xl text-sm leading-6 text-white/82 md:mt-0 md:text-[15px] md:leading-6">
                <p>
                  Des bouteilles d’ici et d’ailleurs. Des producteurs, des
                  bonnes adresses et les gens qui font vivre le vin au Québec.
                </p>

                <p className="mt-3">
                  On rassemble ce qu’on boit, ceux qui le font et les endroits
                  où le découvrir — sans compliquer ce qui devrait rester un
