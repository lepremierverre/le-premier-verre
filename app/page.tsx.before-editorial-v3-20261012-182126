                </p>
              </div>
            </div>
          </>
        </div>
      </section>

      {/* 01 — CE SOIR */}
      <section>
        <div className="lpv-container grid gap-0 py-8 md:grid-cols-2 md:py-[3.5vw]">
          <>
            <div className="h-[280px] overflow-hidden sm:h-[330px] md:h-[460px]">
              <Photo
                src="/images/lpv/bouteille-ce-soir.jpg"
                alt="Moment de table autour du vin"
              />
            </div>
          </>

          <>
            <div className="flex w-full flex-col border-t border-[var(--lpv-line)] px-0 py-8 md:border-t-0 md:px-12 md:py-12 lg:px-16">
              <div>
