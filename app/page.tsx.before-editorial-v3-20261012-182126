          </div>
        </>

        <div className="grid gap-8 md:grid-cols-3 md:gap-10">
          {selectionWines.map((wine, index) => (
            <>
              <Link
                href={`/vins/${wine.slug}`}
                className="group md:flex md:h-full md:flex-col"
