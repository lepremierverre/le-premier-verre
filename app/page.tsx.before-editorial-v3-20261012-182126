                      />
                    </div>
                  </>
                ) : null}

                <>
                  <div className="relative z-10 -mt-5 md:-mt-14 md:px-8">
                    <h2 className="lpv-display max-w-6xl text-[clamp(3.8rem,14vw,6rem)] leading-[0.8] tracking-[-0.045em] md:text-[clamp(6rem,10vw,10rem)]">
                      {featuredProducer.name}
                    </h2>

                    <div className="mt-5 flex flex-col gap-4 border-t border-[var(--lpv-line)] pt-5 md:flex-row md:items-start md:justify-between">
                      <div>
                        {featuredProducer.municipality ? (
                          <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                            {featuredProducer.municipality}
                          </p>
                        ) : null}

                        {featuredProducer.oneLiner ? (
                          <p className="mt-4 max-w-xl text-base leading-7 text-[var(--lpv-muted)]">
                            {featuredProducer.oneLiner}
                          </p>
                        ) : null}
                      </div>

                      <span className="lpv-text-link w-fit">
                        Découvrir le producteur <span>→</span>
                      </span>
                    </div>
                  </div>
                </>
              </div>
            </Link>
          </div>
        </section>
      ) : null}

      {/* 04 — OÙ ALLER */}
      {featuredPlace ? (
        <section className="py-10 md:py-20">
          <div className="lpv-container">
            <>
              <div className="mb-7 flex items-end justify-between border-b border-[var(--lpv-line)] pb-5">
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  04 / Où aller
                </p>

                <Link
                  href="/bonnes-adresses"
                  className="lpv-text-link hidden w-fit md:flex"
                >
                  Toutes les adresses <span>→</span>
                </Link>
              </div>
            </>

            <Link
              href={`/bonnes-adresses/${featuredPlace.slug}`}
              className="group grid gap-0 md:grid-cols-[1.15fr_0.85fr]"
            >
              {featuredPlaceImage ? (
                <>
                  <div className="h-[340px] overflow-hidden bg-[var(--lpv-paper-light)] sm:h-[420px] md:h-[620px]">
                    <img
                      src={featuredPlaceImage}
                      alt={featuredPlace.name}
                      className="h-full w-full object-cover"
                    />
                  </div>
                </>
              ) : null}

              <>
                <div className="flex w-full flex-col justify-between border-t border-[var(--lpv-line)] py-7 md:border-l md:border-t-0 md:px-12 md:py-10 lg:px-16">
                  <div>
                    <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                      {formatPlaceType(featuredPlace.type)}
                    </p>

                    <h2 className="lpv-display mt-5 text-[clamp(3.5rem,13vw,5rem)] leading-[0.84] tracking-[-0.04em] md:text-[clamp(4.5rem,7vw,7.5rem)]">
                      {featuredPlace.name}
                    </h2>

                    {featuredPlaceLocation ? (
                      <p className="mt-5 text-xs uppercase tracking-[0.16em] text-[var(--lpv-muted)]">
                        {featuredPlaceLocation}
                      </p>
                    ) : null}

                    {featuredPlace.highlights?.length ? (
                      <p className="mt-8 max-w-md text-base leading-7 text-[var(--lpv-muted)]">
                        {featuredPlace.highlights.join(" · ")}
                      </p>
                    ) : null}
                  </div>

                  <span className="lpv-text-link mt-10 w-fit">
                    Voir l’adresse <span>→</span>
                  </span>
                </div>
              </>
            </Link>
          </div>
        </section>
      ) : null}

      {/* 05 + 06 — JOURNAL / GUIDE */}
      {(featuredArticle || featuredGuide) ? (
        <section className="lpv-container py-12 md:py-20">
          <div className="grid gap-12 md:grid-cols-[1.35fr_0.65fr] md:gap-10 lg:gap-16">
            {featuredArticle ? (
              <>
                <Link
                  href={`/blog/${featuredArticle.slug}`}
                  className="group block"
                >
                  <div className="border-b border-[var(--lpv-line)] pb-5">
                    <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                      05 / À lire
                    </p>
                  </div>

                  {featuredArticle.coverImage ? (
                    <div className="mt-6 aspect-[16/10] overflow-hidden bg-[var(--lpv-paper-light)]">
                      <img
                        src={urlFor(featuredArticle.coverImage)
                          .width(1500)
                          .height(940)
                          .fit("crop")
                          .url()}
                        alt={featuredArticle.title}
                        className="h-full w-full object-cover"
                      />
                    </div>
                  ) : null}

                  <h2 className="lpv-display mt-6 max-w-4xl text-[clamp(2.8rem,8vw,4.6rem)] leading-[0.9] tracking-[-0.035em]">
                    {featuredArticle.title}
                  </h2>

                  {featuredArticle.excerpt ? (
                    <p className="mt-5 max-w-2xl text-base leading-7 text-[var(--lpv-muted)]">
                      {featuredArticle.excerpt}
                    </p>
                  ) : null}
                </Link>
              </>
            ) : null}

            {featuredGuide ? (
              <>
                <Link
                  href={`/guides/${featuredGuide.slug}`}
                  className="group block"
                >
                  <div className="border-b border-[var(--lpv-line)] pb-5">
                    <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                      06 / À comprendre
                    </p>
                  </div>

                  {featuredGuide.coverImage ? (
                    <div className="mt-6 aspect-[4/5] overflow-hidden bg-[var(--lpv-paper-light)]">
                      <img
                        src={urlFor(featuredGuide.coverImage)
                          .width(900)
                          .height(1125)
                          .fit("crop")
                          .url()}
                        alt={featuredGuide.title}
                        className="h-full w-full object-cover"
                      />
                    </div>
                  ) : null}

                  <h2 className="lpv-display mt-6 text-[clamp(2.5rem,7vw,3.7rem)] leading-[0.9] tracking-[-0.035em]">
                    {featuredGuide.title}
                  </h2>

                  {featuredGuide.excerpt ? (
                    <p className="mt-5 text-sm leading-7 text-[var(--lpv-muted)]">
