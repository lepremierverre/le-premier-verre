                <div className="border-t border-[var(--lpv-line)] pt-4 md:flex md:flex-1 md:flex-col md:pt-5">
                  <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                    {[
                      wine.beverageType === "cider"
