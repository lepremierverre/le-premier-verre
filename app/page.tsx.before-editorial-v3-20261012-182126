                  <h3 className="lpv-display mt-3 text-[1.65rem] leading-[0.98] md:mt-4 md:text-[1.7rem]">
                    {wine.name}
                  </h3>

                  {wine.producer?.name ? (
                    <p className="mt-2 text-sm leading-6 text-[var(--lpv-muted)] md:mt-3">
                      {wine.producer.name}
                      {wine.vintage ? ` · ${wine.vintage}` : ""}
                    </p>
                  ) : null}
                </div>
              </Link>
            </>
          ))}
        </div>
      </section>

      {/* 03 — D'ICI */}
      {featuredProducer ? (
        <section className="py-10 md:py-20">
          <div className="lpv-container">
            <>
              <div className="mb-6 border-b border-[var(--lpv-line)] pb-5">
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  03 / D’ici
                </p>
              </div>
            </>

            <Link
              href={`/producteurs/${featuredProducer.slug}`}
              className="group block"
            >
              <div className="relative">
                {featuredProducer.heroImage ? (
                  <>
                    <div className="h-[420px] overflow-hidden bg-[var(--lpv-paper-light)] md:h-[68vh] md:min-h-[560px] md:max-h-[820px]">
                      <img
                        src={urlFor(featuredProducer.heroImage)
                          .width(2000)
                          .height(1250)
                          .fit("crop")
                          .url()}
