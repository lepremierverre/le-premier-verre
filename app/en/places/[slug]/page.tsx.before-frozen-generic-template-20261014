                      </a>
                    ) : (
                      value
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        ) : null}

        {(place.descriptionEn || place.description)?.length ? (
          <section className="grid gap-10 py-16 md:grid-cols-[0.38fr_0.62fr] md:py-24">
            <div>
              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
