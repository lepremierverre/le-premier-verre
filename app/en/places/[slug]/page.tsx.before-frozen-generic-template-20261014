                    <p className="text-[0.95rem]">
                      Wine bar
                    </p>
                  </div>

                  {place.website ? (
                    <div className="grid gap-3 border-b border-[var(--lpv-line)] py-6 sm:grid-cols-[150px_1fr]">
                      <p className="text-[0.55rem] uppercase tracking-[0.2em] text-[var(--lpv-muted)]">
