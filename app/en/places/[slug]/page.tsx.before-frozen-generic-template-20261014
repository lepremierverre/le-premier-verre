                <div className="md:pl-10">
                  <h2 className="lpv-display text-[clamp(3.2rem,4.5vw,5rem)] leading-[0.9] tracking-[-0.05em]">
                    Their bottles.
                  </h2>
                </div>

                <div className="mt-12 grid grid-cols-2 gap-3 md:grid-cols-5 md:gap-4">
