              </div>

              <div className="md:pt-1">
                <div className="max-w-2xl border-t border-[var(--lpv-line)]">
                  <div className="grid gap-3 border-b border-[var(--lpv-line)] py-6 sm:grid-cols-[150px_1fr]">
