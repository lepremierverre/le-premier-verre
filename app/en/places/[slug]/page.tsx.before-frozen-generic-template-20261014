            </div>

            <dl>
              {facts.map(([label, value], index) => (
                <div
                  key={label}
                  className={`grid gap-2 py-5 sm:grid-cols-[180px_1fr] ${
                    index === 0
                      ? ""
                      : "border-t border-[var(--lpv-line)]"
