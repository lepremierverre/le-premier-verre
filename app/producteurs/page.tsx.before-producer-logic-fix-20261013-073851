import Link from "next/link";
import type { SanityImageSource } from "@sanity/image-url";

import { client } from "@/sanity/lib/client";
import { urlFor } from "@/sanity/lib/image";
import { producersQuery } from "@/sanity/lib/queries";
import ProducerFilters from "@/components/producers/ProducerFilters";

export const revalidate = 60;

type Producer = {
  _id: string;
  name: string;
  slug: string;
  municipality?: string;
  oneLiner?: string;
  shortBio?: string;
  logo?: SanityImageSource;
  photo?: SanityImageSource;
  heroImage?: SanityImageSource;
  lpvPartner?: boolean;
  producerType?: "winery" | "cidery";
  alsoProducesWine?: boolean;
  mediaPermissionStatus?:
    | "none"
    | "provided_by_producer"
    | "authorized_by_producer"
    | "lpv_original"
    | "licensed";
  mediaCredit?: string;
  country?: {
    name?: string;
    slug?: string;
  };
  region?: {
    name?: string;
    slug?: string;
  };
};

type ProducersPageProps = {
  searchParams?: Promise<{
    pays?: string;
    region?: string;
    type?: string;
    origine?: string;
    page?: string;
  }>;
};

const PRODUCERS_PER_PAGE = 24;

const AUTHORIZED_MEDIA_STATUSES = [
  "provided_by_producer",
  "authorized_by_producer",
  "lpv_original",
  "licensed",
];

function getAuthorizedImage(producer: Producer) {
  const hasAuthorizedMedia = AUTHORIZED_MEDIA_STATUSES.includes(
    producer.mediaPermissionStatus || ""
  );

  if (!hasAuthorizedMedia) return null;

  return producer.heroImage || producer.photo || producer.logo || null;
}

function getLocation(producer: Producer) {
  return [
    producer.municipality,
    producer.region?.name,
    producer.country?.name,
  ]
    .filter(Boolean)
    .join(" · ");
}

export default async function ProducersPage({
  searchParams,
}: ProducersPageProps) {
  const params = (await searchParams) || {};
  const producers = await client.fetch<Producer[]>(producersQuery);

  const participatingProducers = producers.filter(
    (producer) => producer.lpvPartner === true
  );

  // Rotation déterministe chaque lundi :
  // mêmes producteurs toute la semaine, ordre différent la semaine suivante.
  const weekIndex = Math.floor(
    (Date.now() + 3 * 24 * 60 * 60 * 1000) /
      (7 * 24 * 60 * 60 * 1000)
  );

  const featuredProducers =
    participatingProducers.length > 0
      ? [
          ...participatingProducers.slice(
            weekIndex % participatingProducers.length
          ),
          ...participatingProducers.slice(
            0,
            weekIndex % participatingProducers.length
          ),
        ]
      : [];

  // La page Producteurs met le Québec au premier plan.
  // Les producteurs "Avec nous" restent aussi présents dans le répertoire.
  const directoryProducers = producers.filter((producer) => {
    const country = producer.country?.name?.toLowerCase().trim();
    const countrySlug = producer.country?.slug?.toLowerCase().trim();

    return country === "canada" || countrySlug === "canada";
  });

  const producerFilter =
    params.type === "vignobles" || params.type === "cidreries"
      ? params.type
      : "tous";

  const isWinery = (producer: Producer) =>
    producer.producerType === "winery" ||
    producer.producerType == null ||
    producer.alsoProducesWine === true;

  const isCidery = (producer: Producer) =>
    producer.producerType === "cidery";

  const wineryCount = directoryProducers.filter(isWinery).length;
  const cideryCount = directoryProducers.filter(isCidery).length;

  const showInternational = params.origine === "ailleurs";

  const internationalProducers = producers.filter((producer) => {
    const country = producer.country?.name?.toLowerCase().trim();
    const countrySlug = producer.country?.slug?.toLowerCase().trim();

    return country !== "canada" && countrySlug !== "canada";
  });

  const typedDirectoryProducers = directoryProducers.filter((producer) => {
    if (producerFilter === "vignobles") return isWinery(producer);
    if (producerFilter === "cidreries") return isCidery(producer);
    return true;
  });

  const countries = Array.from(
    new Map(
      producers
        .filter((producer) => producer.country?.slug && producer.country?.name)
        .map((producer) => [
          producer.country!.slug!,
          {
            slug: producer.country!.slug!,
            name: producer.country!.name!,
          },
        ])
    ).values()
  ).sort((a, b) => a.name.localeCompare(b.name, "fr"));

  const regions = Array.from(
    new Map(
      directoryProducers
        .filter((producer) => producer.region?.slug && producer.region?.name)
        .map((producer) => [
          producer.region!.slug!,
          {
            slug: producer.region!.slug!,
            name: producer.region!.name!,
          },
        ])
    ).values()
  ).sort((a, b) => a.name.localeCompare(b.name, "fr"));

  const selectedCountry = params.pays || "";
  const selectedRegion = params.region || "";

  const baseDirectoryProducers = showInternational
    ? internationalProducers
    : typedDirectoryProducers;

  const filteredDirectoryProducers = baseDirectoryProducers.filter((producer) => {
    const countryMatches =
      !selectedCountry || producer.country?.slug === selectedCountry;

    const regionMatches =
      showInternational ||
      !selectedRegion ||
      producer.region?.slug === selectedRegion;

    return countryMatches && regionMatches;
  });

  const requestedPage = Number.parseInt(params.page || "1", 10);

  const totalPages = Math.max(
    1,
    Math.ceil(filteredDirectoryProducers.length / PRODUCERS_PER_PAGE)
  );

  const currentPage = Number.isFinite(requestedPage)
    ? Math.min(Math.max(requestedPage, 1), totalPages)
    : 1;

  const startIndex = (currentPage - 1) * PRODUCERS_PER_PAGE;

  const visibleDirectoryProducers = filteredDirectoryProducers.slice(
    startIndex,
    startIndex + PRODUCERS_PER_PAGE
  );

  function buildDirectoryUrl({
    pays = selectedCountry,
    region = selectedRegion,
    type = producerFilter,
    origine = showInternational ? "ailleurs" : "",
    page = 1,
  }: {
    pays?: string;
    region?: string;
    type?: string;
    origine?: string;
    page?: number;
  }) {
    const query = new URLSearchParams();

    if (origine) query.set("origine", origine);
    if (pays) query.set("pays", pays);
    if (region && !origine) query.set("region", region);
    if (type && type !== "tous" && !origine) query.set("type", type);
    if (page > 1) query.set("page", String(page));

    const qs = query.toString();

    return qs
      ? `/producteurs?${qs}#repertoire-desktop`
      : "/producteurs#repertoire-desktop";
  }

  return (
    <main className="min-h-screen bg-[var(--lpv-paper)] text-[var(--lpv-ink)]">
      {/* HERO */}

      {/* MOBILE — preserved for later */}
      <section className="border-b border-[var(--lpv-line)] md:hidden">
        <div className="lpv-container py-10">
          <p className="lpv-kicker text-[var(--lpv-cocoa)]">
            Répertoire
          </p>

          <h1 className="lpv-display mt-5 text-[clamp(3.8rem,15vw,4.8rem)] leading-[0.84]">
            Ceux qui
            <br />
            font le vin.
          </h1>

          <div className="mt-7 border-t border-[var(--lpv-line)] pt-5">
            <p className="max-w-md text-[0.95rem] leading-7 text-[var(--lpv-muted)]">
              Des personnes, des gestes, des lieux et des façons de travailler
              qui donnent une identité aux bouteilles.
            </p>
          </div>
        </div>
      </section>

      {/* DESKTOP — new LPV direction */}
      <section className="hidden border-b border-[var(--lpv-line)] md:block">
        <div className="lpv-container pb-16 pt-16 lg:pb-18 lg:pt-20">
          <p className="lpv-kicker text-[var(--lpv-cocoa)]">
            Producteurs
          </p>

          <h1 className="lpv-display mt-7 max-w-[1180px] text-[clamp(5.7rem,8.6vw,9.7rem)] leading-[0.88] tracking-[-0.05em]">
            Ceux qui font
            <br />
            le vin d’ici.
          </h1>

          <div className="mt-10 flex items-center justify-between border-t border-[var(--lpv-line)] pt-5">
            

            <p className="text-[0.65rem] uppercase tracking-[0.17em] text-[var(--lpv-muted)]">
              Québec
            </p>
          </div>
        </div>
      </section>

      {/* AVEC NOUS */}
      {featuredProducers.length > 0 ? (
        <>
          {/* MOBILE — preserved for later */}
          <section className="lpv-container py-10 md:hidden">
            <div className="border-b border-[var(--lpv-line)] pb-5">
              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                Avec nous
              </p>

              <h2 className="lpv-display mt-3 text-[2.8rem] leading-[0.95]">
                Ceux qu’on connaît de plus près.
              </h2>
            </div>

            <div>
              {featuredProducers.map((producer) => {
                const image = getAuthorizedImage(producer);

                const imageSrc = image
                  ? urlFor(image)
                      .width(1200)
                      .height(900)
                      .fit("crop")
                      .url()
                  : null;

                const location = getLocation(producer);

                return (
                  <article
                    key={producer._id}
                    className="group border-b border-[var(--lpv-line)] py-7"
                  >
                    <Link
                      href={`/producteurs/${producer.slug}`}
                      className="block"
                    >
                      {imageSrc ? (
                        <div className="h-[280px] overflow-hidden bg-[var(--lpv-paper-light)]">
                          <img
                            src={imageSrc}
                            alt={producer.name}
                            className="h-full w-full object-cover"
                          />
                        </div>
                      ) : null}
                    </Link>

                    <div className="pt-5">
                      <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                        Avec nous
                      </p>

                      <Link href={`/producteurs/${producer.slug}`}>
                        <h3 className="lpv-display mt-3 text-[2.65rem] leading-[0.9] tracking-[-0.035em]">
                          {producer.name}
                        </h3>
                      </Link>

                      {location ? (
                        <p className="mt-3 text-[0.68rem] uppercase tracking-[0.14em] text-[var(--lpv-muted)]">
                          {location}
                        </p>
                      ) : null}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>

          {/* DESKTOP — AVEC NOUS / horizontal rail */}
          <section className="hidden overflow-hidden bg-[var(--lpv-cocoa)] text-[var(--lpv-paper-light)] md:block">
            <div className="lpv-container py-16 lg:py-18">

              <div className="flex items-end justify-between gap-12">
                <div>
                  <p className="lpv-kicker text-white/50">
                    Avec nous
                  </p>

                  <h2 className="lpv-display mt-4 text-[clamp(4.2rem,5.7vw,6.4rem)] leading-[0.86] tracking-[-0.045em]">
                    De plus près.
                  </h2>
                </div>

                <div className="max-w-sm pb-1">
                  <p className="text-sm leading-6 text-white/60">
                    Des fiches réalisées avec les producteurs et des informations
                    validées directement avec eux.
                  </p>

                </div>
              </div>

              <div className="mt-9 overflow-x-auto pb-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                <div className="flex w-max gap-4 pr-10">
                  {featuredProducers.map((producer) => {
                    const image = getAuthorizedImage(producer);

                    const imageSrc = image
                      ? urlFor(image)
                          .width(1000)
                          .height(760)
                          .fit("crop")
                          .url()
                      : null;

                    const location = [
                      producer.municipality,
                      producer.region?.name,
                    ]
                      .filter(Boolean)
                      .join(" · ");

                    return (
                      <article
                        key={producer._id}
                        className="group w-[360px] shrink-0 bg-[var(--lpv-paper)] text-[var(--lpv-ink)] lg:w-[390px]"
                      >
                        <Link
                          href={`/producteurs/${producer.slug}`}
                          className="block h-full"
                        >
                          <div className="aspect-[4/3] overflow-hidden bg-[var(--lpv-paper-light)]">
                            {imageSrc ? (
                              <img
                                src={imageSrc}
                                alt={producer.name}
                                className="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.012]"
                              />
                            ) : (
                              <div className="flex h-full items-center justify-center px-8 text-center">
                                <span className="lpv-kicker text-[var(--lpv-muted)]/45">
                                  {producer.name}
                                </span>
                              </div>
                            )}
                          </div>

                          <div className="flex min-h-[155px] flex-col px-6 pb-6 pt-5">
                            <div className="flex items-center justify-between gap-4">
                              <p className="text-[0.56rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-cocoa)]">
                                Avec nous
                              </p>

                              <span
                                aria-hidden="true"
                                className="text-sm text-[var(--lpv-muted)]"
                              >
                                ↗
                              </span>
                            </div>

                            <h3 className="lpv-display mt-3 text-[2.5rem] leading-[0.9] tracking-[-0.035em]">
                              {producer.name}
                            </h3>

                            {location ? (
                              <p className="mt-auto pt-5 text-[0.58rem] uppercase tracking-[0.15em] text-[var(--lpv-muted)]">
                                {location}
                              </p>
                            ) : null}
                          </div>
                        </Link>
                      </article>
                    );
                  })}
                </div>
              </div>

              <div className="mt-4 flex items-center justify-between">
                <p className="text-[0.58rem] uppercase tracking-[0.18em] text-white/35">
                  {featuredProducers.length} avec nous
                </p>

                <p className="text-[0.58rem] font-semibold uppercase tracking-[0.18em] text-white/55">
                  Glisser →
                </p>
              </div>

            </div>
          </section>
        </>
      ) : null}

      {/* RÉPERTOIRE */}

      {/* MOBILE — ancien répertoire conservé pour notre passe mobile */}
      {directoryProducers.length > 0 ? (
        <section
          id="repertoire"
          className="scroll-mt-24 md:hidden"
        >
          <div className="lpv-container py-10">
            <div className="pb-6">
              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                Le répertoire
              </p>

              <h2 className="lpv-display mt-3 text-[clamp(3.1rem,13vw,4rem)] leading-[0.86]">
                Tous les
                <br />
                producteurs.
              </h2>
            </div>

            <div className="border-t border-[var(--lpv-line)]">
              {visibleDirectoryProducers.map((producer, index) => {
                const location = getLocation(producer);

                return (
                  <article
                    key={producer._id}
                    className="group border-b border-[var(--lpv-line)]"
                  >
                    <Link
                      href={`/producteurs/${producer.slug}`}
                      className="grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 py-4"
                    >
                      <div>
                        <span className="text-[0.6rem] tracking-[0.16em] text-[var(--lpv-muted)]">
                          {String(startIndex + index + 1).padStart(2, "0")}
                        </span>

                        <h3 className="lpv-display mt-2 text-[clamp(1.8rem,7.5vw,2.2rem)] leading-[0.94] tracking-[-0.035em]">
                          {producer.name}
                        </h3>

                        {location ? (
                          <p className="mt-2 text-[0.6rem] uppercase leading-5 tracking-[0.13em] text-[var(--lpv-muted)]">
                            {location}
                          </p>
                        ) : null}
                      </div>

                      <span aria-hidden="true" className="self-center text-lg">
                        →
                      </span>
                    </Link>
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      ) : null}

      {/* DESKTOP — typographic Quebec directory */}
      {directoryProducers.length > 0 ? (
        <section
          id="repertoire-desktop"
          className="hidden scroll-mt-24 bg-[var(--lpv-paper)] md:block"
        >
          <div className="lpv-container py-20 lg:py-24">

            <div className="grid grid-cols-[0.72fr_0.28fr] items-end gap-12 pb-10">
              <div>
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Le répertoire
                </p>

                <h2 className="lpv-display mt-5 text-[clamp(4.2rem,6.7vw,7.4rem)] leading-[0.85] tracking-[-0.045em]">
                  Le Québec,
                  <br />
                  domaine par domaine.
                </h2>
              </div>

              <div className="justify-self-end pb-2">
                <p className="text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-cocoa)]">
                  {filteredDirectoryProducers.length} producteur
                  {filteredDirectoryProducers.length > 1 ? "s" : ""}
                </p>

                <p className="mt-5 max-w-xs text-sm leading-6 text-[var(--lpv-muted)]">
                  Vignobles, cidreries et domaines à découvrir partout au Québec.
                </p>
              </div>
            </div>

            <div className="mb-6 flex items-center gap-6 border-t border-[var(--lpv-line)] pt-5">
              <span className="text-[0.56rem] font-semibold uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                Afficher
              </span>

              <Link
                href={buildDirectoryUrl({ type: "tous", pays: "", region: "", origine: "", page: 1 })}
                className={`text-[0.62rem] uppercase tracking-[0.16em] ${
                  producerFilter === "tous"
                    ? "text-[var(--lpv-cocoa)] underline underline-offset-4"
                    : "text-[var(--lpv-muted)]"
                }`}
              >
                Tous
              </Link>

              <Link
                href={buildDirectoryUrl({ type: "vignobles", pays: "", region: "", origine: "", page: 1 })}
                className={`text-[0.62rem] uppercase tracking-[0.16em] ${
                  producerFilter === "vignobles"
                    ? "text-[var(--lpv-cocoa)] underline underline-offset-4"
                    : "text-[var(--lpv-muted)]"
                }`}
              >
                Vignobles
              </Link>

              <Link
                href={buildDirectoryUrl({ type: "cidreries", pays: "", region: "", origine: "", page: 1 })}
                className={`text-[0.62rem] uppercase tracking-[0.16em] ${
                  producerFilter === "cidreries"
                    ? "text-[var(--lpv-cocoa)] underline underline-offset-4"
                    : "text-[var(--lpv-muted)]"
                }`}
              >
                Cidreries
              </Link>
            </div>

            <div className="grid grid-cols-3 border-l border-t border-[var(--lpv-line)]">
              {filteredDirectoryProducers.map((producer, index) => {
                const region =
                  producer.region?.name ||
                  producer.municipality ||
                  "Québec";

                const municipality =
                  producer.municipality &&
                  producer.municipality !== region
                    ? producer.municipality
                    : null;

                return (
                  <article
                    key={producer._id}
                    className="group min-w-0 border-b border-r border-[var(--lpv-line)]"
                  >
                    <Link
                      href={`/producteurs/${producer.slug}`}
                      className="relative flex min-h-[245px] flex-col overflow-hidden px-7 pb-7 pt-7 transition-colors duration-300 hover:bg-[var(--lpv-paper-light)]"
                    >
                      <span
                        aria-hidden="true"
                        className="pointer-events-none absolute -right-1 -top-5 text-[6.5rem] font-light leading-none tracking-[-0.08em] text-[var(--lpv-cocoa)] opacity-[0.045]"
                      >
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <div className="relative flex items-start justify-between gap-5">
                        <p className="text-[0.57rem] font-semibold uppercase tracking-[0.17em] text-[var(--lpv-cocoa)]">
                          {producer.lpvPartner ? "✦ Avec nous" : region}
                        </p>

                        <span
                          aria-hidden="true"
                          className="text-sm text-[var(--lpv-muted)] transition-transform duration-300 group-hover:translate-x-1"
                        >
                          →
                        </span>
                      </div>

                      <h3 className="lpv-display mt-8 max-w-[95%] text-[clamp(2.25rem,2.8vw,3.3rem)] leading-[0.9] tracking-[-0.04em]">
                        {producer.name}
                      </h3>

                      <div className="mt-auto pt-8">
                        {producer.lpvPartner ? (
                          <p className="text-[0.57rem] uppercase tracking-[0.15em] text-[var(--lpv-muted)]">
                            {[municipality, region]
                              .filter(Boolean)
                              .join(" · ")}
                          </p>
                        ) : municipality ? (
                          <p className="text-[0.57rem] uppercase tracking-[0.15em] text-[var(--lpv-muted)]">
                            {municipality}
                          </p>
                        ) : (
                          <p className="text-[0.57rem] uppercase tracking-[0.15em] text-[var(--lpv-muted)]">
                            Québec
                          </p>
                        )}
                      </div>
                    </Link>
                  </article>
                );
              })}
            </div>

          </div>
        </section>
      ) : null}

      {/* AILLEURS — DESKTOP */}
      <section className="relative hidden overflow-hidden bg-[var(--lpv-paper)] md:block">
        <div
          aria-hidden="true"
          className="pointer-events-none absolute right-[3vw] top-1/2 -translate-y-1/2 select-none text-[clamp(8rem,17vw,17rem)] font-light leading-none tracking-[-0.08em] text-[var(--lpv-cocoa)] opacity-[0.035]"
        >
          MONDE
        </div>

        <div className="lpv-container relative py-12 lg:py-14">
          <div className="grid grid-cols-[0.66fr_0.34fr] items-center gap-12 border-t border-[var(--lpv-line)] pt-9">
            <div>
              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                Et ailleurs
              </p>

              <h2 className="lpv-display mt-4 text-[clamp(3rem,4.4vw,4.9rem)] leading-[0.9] tracking-[-0.04em]">
                Le reste du monde,
                <br />
                aussi.
              </h2>
            </div>

            <div className="justify-self-end">
              <p className="max-w-sm text-sm leading-6 text-[var(--lpv-muted)]">
                Les domaines d’ailleurs restent dans LPV — à découvrir par pays,
                région et bouteille.
              </p>

              <Link
                href="/producteurs?origine=ailleurs#repertoire-desktop"
                className="mt-6 inline-flex items-center gap-4 text-sm font-medium text-[var(--lpv-cocoa)] transition-[gap,opacity] hover:gap-6 hover:opacity-65"
              >
                Tous les producteurs d’ailleurs
                <span aria-hidden="true">→</span>
              </Link>
            </div>
          </div>
        </div>
      </section>

      {producers.length === 0 ? (
        <section className="lpv-container py-24 text-center">
          <p className="lpv-kicker text-[var(--lpv-cocoa)]">
            Bientôt
          </p>

          <h2 className="lpv-display mt-6 text-5xl md:text-7xl">
            Les portraits arrivent.
          </h2>

          <p className="mx-auto mt-6 max-w-xl text-base leading-8 text-[var(--lpv-muted)]">
            Les premiers producteurs seront ajoutés au fil des rencontres et
            des bouteilles découvertes.
          </p>

          <Link href="/vins" className="lpv-button mt-9">
            Explorer les vins
          </Link>
        </section>
      ) : null}
    </main>
  );
}
