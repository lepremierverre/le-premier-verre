import Link from "next/link";
import { notFound } from "next/navigation";
import { PortableText } from "@portabletext/react";
import type { PortableTextBlock } from "@portabletext/types";
import type { SanityImageSource } from "@sanity/image-url";

import { client } from "@/sanity/lib/client";
import { urlFor } from "@/sanity/lib/image";
import { producerBySlugQuery } from "@/sanity/lib/queries";
import BottleStage from "@/components/wine/BottleStage";
import { buildDynamicMetadata } from "@/lib/seo/dynamic-metadata";
import AnalyticsEvent from "@/components/analytics/AnalyticsEvent";
import ProducerWebsiteLink from "@/components/analytics/ProducerWebsiteLink";

export const revalidate = 60;

type Producer = {
  _id: string;
  name: string;
  slug: string;

  municipality?: string;

  country?: {
    name?: string;
    slug?: string;
  };

  region?: {
    name?: string;
    slug?: string;
  };

  appellation?: {
    name?: string;
    slug?: string;
  };

  logo?: SanityImageSource;
  photo?: SanityImageSource;
  heroImage?: SanityImageSource;

  mediaPermissionStatus?:
    | "none"
    | "provided_by_producer"
    | "authorized_by_producer"
    | "lpv_original"
    | "licensed";
  mediaCredit?: string;
  mediaPermissionDate?: string;
  mediaPermissionNote?: string;

  oneLiner?: string;
  shortBio?: string;
  bio?: PortableTextBlock[];

  approach?: {
    _key?: string;
    title?: string;
    text?: string;
  }[];

  signatureGrapes?: {
    _id?: string;
    name?: string;
    slug?: string;
  }[];

  whyWeFollow?: string;

  openToVisitors?: boolean;
  visitDetails?: string;
  address?: string;
  reservationRequired?: boolean;
  website?: string;

  instagram?: string;
  facebook?: string;

  wines?: {
    _id: string;
    name: string;
    slug: string;
    vintage?: number;
    color?: string;
    bottleImage?: SanityImageSource;
    approxPrice?: number;
  }[];

  articles?: {
    _id: string;
    title: string;
    slug: string;
    excerpt?: string;
  }[];

  guides?: {
    _id: string;
    title: string;
    slug: string;
    excerpt?: string;
  }[];
};

function formatPrice(value?: number) {
  if (typeof value !== "number") return null;

  return new Intl.NumberFormat("fr-CA", {
    style: "currency",
    currency: "CAD",
  }).format(value);
}

function formatColor(value?: string) {
  if (!value) return null;

  const labels: Record<string, string> = {
    red: "Rouge",
    white: "Blanc",
    rose: "Rosé",
    orange: "Orange",
    sparkling: "Effervescent",
    fortified: "Fortifié",
  };

  return labels[value] || value;
}

export async function generateMetadata({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;

  return buildDynamicMetadata({
    entity: "producer",
    slug,
    locale: "fr",
  });
}

export default async function ProducerPage({
  params,
}: {
  params: Promise<{ slug: string }>;
}) {
  const { slug } = await params;

  const producer = await client.fetch<Producer | null>(
    producerBySlugQuery,
    { slug }
  );

  if (!producer) notFound();

  const authorizedMediaStatuses = new Set([
    "provided_by_producer",
    "authorized_by_producer",
    "lpv_original",
    "licensed",
  ]);

  const hasAuthorizedMedia =
    !!producer.mediaPermissionStatus &&
    authorizedMediaStatuses.has(producer.mediaPermissionStatus);

  const authorizedImage =
    hasAuthorizedMedia
      ? producer.heroImage || producer.photo || producer.logo
      : null;

  const authorizedImageSrc = authorizedImage
    ? urlFor(authorizedImage)
        .width(1600)
        .fit("max")
        .url()
    : null;

  const location = [
    producer.municipality,
    producer.region?.name,
    producer.country?.name,
  ]
    .filter(Boolean)
    .join(" · ");

  const hasVisitInformation =
    producer.openToVisitors !== undefined ||
    Boolean(producer.address) ||
    Boolean(producer.visitDetails) ||
    Boolean(producer.website);

  return (
    <main className="min-h-screen bg-[var(--lpv-paper)] text-[var(--lpv-ink)]">
      <AnalyticsEvent
        eventName="producer_view"
        data={{
          producerId: producer._id,
        }}
      />
      <article className="lpv-container pb-24">

        <div className="pt-8 md:pt-10">
          <Link href="/producteurs" className="lpv-text-link">
            <span>←</span> Retour aux producteurs
          </Link>
        </div>

        {/* HERO — FICHE PRODUCTEUR */}

        <section className="border-b border-[var(--lpv-line)] pb-14 pt-12 md:pb-20 md:pt-16">

          <p className="lpv-kicker text-[var(--lpv-cocoa)]">
            Producteur · Avec nous
          </p>

          <div className="mt-10 grid gap-10 md:mt-12 md:grid-cols-[0.9fr_1.1fr] md:items-center md:gap-16">

            <div>
              <h1
                className={`lpv-display tracking-[-0.055em] ${
                  producer.name.length > 18
                    ? "max-w-[10ch] text-[clamp(4rem,6.6vw,6.8rem)] leading-[0.84]"
                    : "max-w-[10ch] text-[clamp(4.2rem,7vw,7.2rem)] leading-[0.83]"
                }`}
              >
                {producer.name}
              </h1>

              {producer.oneLiner ? (
                <p className="mt-8 max-w-[25ch] border-t border-[var(--lpv-line)] pt-7 text-[clamp(1.35rem,1.9vw,1.85rem)] font-medium leading-[1.12] tracking-[-0.03em]">
                  {producer.oneLiner}
                </p>
              ) : producer.shortBio ? (
                <p className="mt-8 max-w-xl border-t border-[var(--lpv-line)] pt-7 text-lg leading-8">
                  {producer.shortBio}
                </p>
              ) : null}

              <div className="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
                {producer.municipality ? (
                  <span className="text-[0.65rem] uppercase tracking-[0.17em] text-[var(--lpv-muted)]">
                    {producer.municipality}, Québec
                  </span>
                ) : producer.region?.name ? (
                  <span className="text-[0.65rem] uppercase tracking-[0.17em] text-[var(--lpv-muted)]">
                    {producer.region.name}
                  </span>
                ) : null}

                {producer.website ? (
                  <ProducerWebsiteLink
                    href={producer.website}
                    producerId={producer._id}
                    locale="fr"
                    target="_blank"
                    rel="noreferrer"
                    className="lpv-text-link"
                  >
                    Site officiel <span>↗</span>
                  </ProducerWebsiteLink>
                ) : null}
              </div>
            </div>

            {authorizedImageSrc ? (
              <div>
                <div className="aspect-[5/4] overflow-hidden bg-[var(--lpv-paper-light)]">
                  <img
                    src={authorizedImageSrc}
                    alt={producer.name}
                    className="h-full w-full object-cover"
                  />
                </div>

                <div className="mt-3 flex items-center justify-between gap-5">
                  <p className="text-[0.56rem] uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                    Visuel autorisé
                  </p>

                  {producer.mediaCredit ? (
                    <p className="text-[0.65rem] text-[var(--lpv-muted)]">
                      © {producer.mediaCredit}
                    </p>
                  ) : null}
                </div>
              </div>
            ) : null}

          </div>

        </section>

        {/* LE DOMAINE */}

        {producer.bio?.length ? (
          <section className="border-b border-[var(--lpv-line)] py-16 md:py-24">

            <div className="grid gap-10 md:grid-cols-[0.34fr_0.66fr] md:gap-16">

              <div>
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Le domaine
                </p>

                <h2 className="lpv-display mt-6 text-[clamp(3.4rem,5vw,5.7rem)] leading-[0.88] tracking-[-0.05em]">
                  Bergeville.
                </h2>
              </div>

              <div className="lpv-prose max-w-3xl text-lg leading-9 md:pt-8">
                <PortableText value={producer.bio} />
              </div>

            </div>

          </section>
        ) : null}

        {/* APPROCHE */}

        {producer.approach?.length ? (
          <section className="border-b border-[var(--lpv-line)] py-16 md:py-24">

            <div className="flex items-end justify-between gap-8">
              <div>
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  À savoir
                </p>

                <h2 className="lpv-display mt-6 text-[clamp(3.4rem,5vw,5.7rem)] leading-[0.88] tracking-[-0.05em]">
                  Trois choses.
                </h2>
              </div>
            </div>

            <div className="mt-12 grid border-y border-[var(--lpv-line)] md:grid-cols-3">

              {producer.approach.slice(0, 3).map((item, index) => (
                <article
                  key={item._key || `${item.title}-${index}`}
                  className={`min-h-[310px] py-8 md:px-8 md:py-10 ${
                    index > 0
                      ? "border-t border-[var(--lpv-line)] md:border-l md:border-t-0"
                      : ""
                  } ${index === 0 ? "md:pl-0" : ""}`}
                >
                  <p className="text-[0.6rem] tracking-[0.18em] text-[var(--lpv-muted)]">
                    {String(index + 1).padStart(2, "0")}
                  </p>

                  {item.title ? (
                    <h3 className="lpv-display mt-10 max-w-[11ch] text-[clamp(2.2rem,3vw,3.5rem)] leading-[0.92] tracking-[-0.045em]">
                      {item.title}
                    </h3>
                  ) : null}

                  {item.text ? (
                    <p className="mt-7 max-w-sm text-sm leading-7 text-[var(--lpv-muted)]">
                      {item.text}
                    </p>
                  ) : null}
                </article>
              ))}

            </div>

          </section>
        ) : null}

        {/* CÉPAGES — NON CLIQUABLES AU LANCEMENT */}

        {producer.signatureGrapes?.length ? (
          <section className="border-b border-[var(--lpv-line)] py-14 md:py-16">
            <div className="grid gap-7 md:grid-cols-[0.24fr_0.76fr] md:items-start">

              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                Dans les vignes
              </p>

              <div className="flex max-w-5xl flex-wrap gap-x-3 gap-y-2">
                {producer.signatureGrapes.map((grape, index) => (
                  <span
                    key={grape._id || grape.name}
                    className="lpv-display text-[clamp(2rem,3.5vw,3.8rem)] leading-[0.95] tracking-[-0.045em]"
                  >
                    {grape.name}
                    {index < producer.signatureGrapes!.length - 1 ? (
                      <span className="ml-3 text-[var(--lpv-muted)]">·</span>
                    ) : null}
                  </span>
                ))}
              </div>

            </div>
          </section>
        ) : null}

        {/* NOTRE REGARD */}

        {producer.whyWeFollow ? (
          <section className="relative left-1/2 w-screen -translate-x-1/2 bg-[var(--lpv-cocoa)] text-[var(--lpv-paper)]">
            <div className="lpv-container py-14 md:py-20">

              <div className="grid gap-10 md:grid-cols-[0.27fr_0.73fr] md:gap-16">

                <div>
                  <p className="lpv-kicker text-[var(--lpv-paper)] opacity-65">
                    Le Premier Verre
                  </p>

                  <h2 className="lpv-display mt-6 text-[clamp(2.8rem,4vw,4.7rem)] leading-[0.88] tracking-[-0.05em]">
                    Notre regard.
                  </h2>
                </div>

                <p className="max-w-4xl text-[clamp(1.65rem,2.5vw,2.8rem)] leading-[1.1] tracking-[-0.04em] md:pt-3">
                  {producer.whyWeFollow}
                </p>

              </div>

            </div>
          </section>
        ) : null}

        {/* À DÉCOUVRIR — SÉLECTION */}

        {producer.wines?.length ? (
          <section className="relative left-1/2 w-screen -translate-x-1/2 bg-[var(--lpv-cocoa)] text-[var(--lpv-paper)]">
            <div className="lpv-container pb-16 pt-6 md:pb-20 md:pt-8">

              <div className="flex items-end justify-between gap-8 pb-8">
                <div>
                  <p className="lpv-kicker text-[var(--lpv-paper)] opacity-65">
                    À découvrir
                  </p>

                  <h2 className="lpv-display mt-5 text-[clamp(3.5rem,5vw,5.8rem)] leading-[0.88] tracking-[-0.05em]">
                    5 bouteilles.
                  </h2>
                </div>

                <Link
                  href="/vins"
                  className="hidden border-b border-[var(--lpv-paper)] pb-1 text-[0.62rem] uppercase tracking-[0.16em] md:inline-flex"
                >
                  Tous leurs vins <span className="ml-2">→</span>
                </Link>
              </div>

              <div className="-mx-4 overflow-x-auto px-4 [scrollbar-width:none] md:-mx-0 md:px-0 [&::-webkit-scrollbar]:hidden">
                <div className="flex w-max gap-3 pb-3">

                  {producer.wines.slice(0, 5).map((wine, index) => (
                    <Link
                      key={wine._id}
                      href={`/vins/${wine.slug}`}
                      className="group flex h-[500px] w-[76vw] max-w-[350px] shrink-0 flex-col bg-[var(--lpv-paper)] p-5 text-[var(--lpv-ink)] md:h-[520px] md:w-[350px] md:p-6"
                    >
                      <p className="lpv-display text-[1.8rem] text-[var(--lpv-muted)] opacity-55">
                        {String(index + 1).padStart(2, "0")}
                      </p>

                      <div className="flex min-h-0 flex-1 items-center justify-center py-3">
                        <BottleStage
                          image={wine.bottleImage}
                          alt={wine.name ?? "Bouteille de vin"}
                          color={wine.color ?? undefined}
                          variant="card"
                          className="h-full max-h-[285px] transition-transform duration-500 group-hover:scale-[1.018]"
                        />
                      </div>

                      <div className="border-t border-[var(--lpv-line)] pt-4">
                        <p className="text-[0.58rem] uppercase tracking-[0.18em] text-[var(--lpv-muted)]">
                          {[formatColor(wine.color), wine.vintage]
                            .filter(Boolean)
                            .join(" · ") || "Vin"}
                        </p>

                        <h3 className="lpv-display mt-3 max-w-[13ch] text-[2rem] leading-[0.92] tracking-[-0.04em]">
                          {wine.name}
                        </h3>

                        <p className="mt-6 text-xs leading-5 text-[var(--lpv-muted)]">
                          {producer.name}
                        </p>
                      </div>
                    </Link>
                  ))}

                </div>
              </div>

              <div className="mt-5 flex items-center justify-between">
                <span className="text-[0.58rem] uppercase tracking-[0.18em] opacity-55">
                  Glisser →
                </span>

                <Link
                  href="/vins"
                  className="border-b border-[var(--lpv-paper)] pb-1 text-[0.6rem] uppercase tracking-[0.16em] md:hidden"
                >
                  Tous leurs vins →
                </Link>
              </div>

            </div>
          </section>
        ) : null}

        {/* VISITER */}

        {(producer.openToVisitors ||
          producer.visitDetails ||
          producer.address ||
          producer.website) ? (
          <section className="border-b border-[var(--lpv-line)] py-16 md:py-24">

            <div className="grid gap-12 md:grid-cols-[0.34fr_0.66fr] md:gap-16">

              <div>
                <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                  Sur place
                </p>

                <h2 className="lpv-display mt-6 text-[clamp(3.8rem,5.4vw,6rem)] leading-[0.86] tracking-[-0.05em]">
                  Visiter.
                </h2>
              </div>

              <div className="md:pt-7">

                {producer.address ? (
                  <p className="lpv-display max-w-[18ch] text-[clamp(2.1rem,3.3vw,3.8rem)] leading-[0.98] tracking-[-0.04em]">
                    {producer.address}
                  </p>
                ) : producer.municipality ? (
                  <p className="lpv-display text-[clamp(2.1rem,3.3vw,3.8rem)] leading-[0.98] tracking-[-0.04em]">
                    {producer.municipality}, Québec
                  </p>
                ) : null}

                {producer.visitDetails ? (
                  <p className="mt-8 max-w-2xl text-base leading-8 text-[var(--lpv-muted)]">
                    {producer.visitDetails}
                  </p>
                ) : null}

                <div className="mt-10 flex flex-wrap items-center gap-x-10 gap-y-5 border-t border-[var(--lpv-line)] pt-6">

                  {typeof producer.openToVisitors === "boolean" ? (
                    <p className="text-[0.68rem] uppercase tracking-[0.16em]">
                      Visites{" "}
                      <span className="ml-2 text-[var(--lpv-muted)]">
                        {producer.openToVisitors ? "Oui" : "Non"}
                      </span>
                    </p>
                  ) : null}

                  {producer.visitReservationRequired ? (
                    <p className="text-[0.68rem] uppercase tracking-[0.16em]">
                      Sur réservation
                    </p>
                  ) : producer.openToVisitors ? (
                    <p className="text-[0.68rem] uppercase tracking-[0.16em] text-[var(--lpv-muted)]">
                      Sans réservation
                    </p>
                  ) : null}

                  {producer.website ? (
                    <ProducerWebsiteLink
                      href={producer.website}
                      producerId={producer._id}
                      locale="fr"
                      target="_blank"
                      rel="noreferrer"
                      className="lpv-text-link"
                    >
                      Site officiel <span>↗</span>
                    </ProducerWebsiteLink>
                  ) : null}

                </div>

              </div>

            </div>

          </section>
        ) : null}

        {/* CONTENU ASSOCIÉ */}

        {producer.articles?.length || producer.guides?.length ? (
          <section className="py-16 md:py-24">

            <div className="border-b border-[var(--lpv-line)] pb-6">

              <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                Pour aller plus loin
              </p>

              <h2 className="lpv-display mt-5 text-5xl leading-none md:text-7xl">
                À lire.
              </h2>

            </div>

            <div className="grid md:grid-cols-2">

              {producer.articles?.map((article, index) => (
                <Link
                  key={article._id}
                  href={`/blog/${article.slug}`}
                  className={`group border-b border-[var(--lpv-line)] py-10 ${
                    index % 2 === 0
                      ? "md:border-r md:pr-10"
                      : "md:pl-10"
                  }`}
                >
                  <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                    Article
                  </p>

                  <h3 className="lpv-display mt-5 text-4xl leading-[0.92]">
                    {article.title}
                  </h3>

                  {article.excerpt ? (
                    <p className="mt-5 max-w-xl text-sm leading-7 text-[var(--lpv-muted)]">
                      {article.excerpt}
                    </p>
                  ) : null}

                  <span className="lpv-text-link mt-7">
                    Lire <span>→</span>
                  </span>
                </Link>
              ))}

              {producer.guides?.map((guide, index) => (
                <Link
                  key={guide._id}
                  href={`/guides/${guide.slug}`}
                  className={`group border-b border-[var(--lpv-line)] py-10 ${
                    index % 2 === 0
                      ? "md:border-r md:pr-10"
                      : "md:pl-10"
                  }`}
                >
                  <p className="lpv-kicker text-[var(--lpv-cocoa)]">
                    Guide
                  </p>

                  <h3 className="lpv-display mt-5 text-4xl leading-[0.92]">
                    {guide.title}
                  </h3>

                  <span className="lpv-text-link mt-7">
                    Lire <span>→</span>
                  </span>
                </Link>
              ))}

            </div>
          </section>
        ) : null}

      </article>
    </main>
  );
}
